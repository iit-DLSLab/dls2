struct ImuKvhMsg
{
	float angular_velocity[3];
	float specific_force[3];
	unsigned long time_stamp;
	octet seq;
	octet status; //119 - gyro and acc valid
	unsigned short time_sync; //This indicates the states of the camera and Lidar sync pulses. Bit 0 indicates the state of the camera sync pulse, Bit 1 indicates the state of the Lidar sync pulse. (0 = both low; 1 = only camera sync high; 2 = only Lidar sync high; 3 = both high)
};
