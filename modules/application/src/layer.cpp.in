#include "dls2/application/layer.hpp"
#include "dls2/class_loader.hpp"

using namespace dls;

Layer::Layer(const std::string &ID, int sleep_time_ms) 
	: App(ID)
	, components_mutex()
    , components({})
	, sleep_time (std::chrono::milliseconds(sleep_time_ms))
	, ddspart_layer(std::make_shared<dls::DDSParticipant>(ID, dls::domains::layers))
{
	// With Discovery Server, a Client A can discover a Client B if and only if B has at least 1 Writer/Reader. Therefore, a fake writer is added to a layer to allow the Supervisor to discover the layers
	const std::string writer_name(ID + " fake writer");
	ddspart_layer->addWriter(writer_name, dls::topics::command_call);
}
Layer::~Layer()
{ }

void Layer::addComponent(const std::string &name, pComponent_t component)
{
	std::lock_guard<std::mutex> lock(this->components_mutex);
	this->components[name] = component;
}

void Layer::removeComponent(const std::string &name)
{
	std::lock_guard<std::mutex> lock(this->components_mutex);
	this->components.erase(name);
}

AppStatus Layer::getComponentStatus(const std::string &name)
{
	std::lock_guard<std::mutex> lock(this->components_mutex);
	auto it = this->components.find(name);

	if(it != this->components.end())
	{
		return it->second->getStatus();
	}
	else
	{
		return AppStatus::UNCONSTRUCTED;
	}
}

bool Layer::loadComponentFromDisk(const std::string &name)
{
    const std::string ID(name);
	if(this->components.find(ID) != this->components.end())
	{
		this->app_logger.info(name + " is already loaded.");
		return false;
	}

	std::shared_ptr<App> component;
	// First try from the current directory
	try
	{
		component = ClassLoader::loadClass<App>
		(
			std::string("/usr/lib/dls2/lib") + name + ".so",
			ID
		);
	}
	catch (const std::exception &e)
	{
        this->app_logger.error(e.what());

		// Try from install location of this layer
		try
		{
			component = ClassLoader::loadClass<App>
			(
				std::string("@DLS_INSTALL_COMPONENT_BASE_DIR@") + "/" + this->getID() + "/" + name + ".so",
				ID
			);
		}
		catch (const std::exception &e)
		{
            this->app_logger.error(e.what());
            this->app_logger.error(name + " not found");
            return false;
		}
	}

	this->app_logger.info(name + " is loaded.");

	this->addComponent(ID, component);
	
    return true;

}

AppStatus Layer::run()
{
	while(!sm.isRaised(sm.deactivation_request) &&  !sm.isRaised(sm.quit_request))
	{
		monitor();
		std::this_thread::sleep_for(sleep_time);
	}

	if(sm.isRaised(sm.deactivation_request))
	    sm.nextState(sm.deactivation_request);
	else if (sm.isRaised(sm.quit_request))
	{
	    sm.nextState(sm.quit_request);
	}
	return getStatus();
}

void Layer::monitor(){}