#!/bin/bash

info () {
  echo "Python periodic plugin skeleton generator"
  echo "App name convention: all lower case letters, use _ to separate words"
  echo "Required message modules: comma-separated FastDDS Python module names (example: BlindState,ControlSignal)"
  echo -e "-----------------------------------------------------\n"
}

check_app_name () {
  if ! $(echo "$1" | grep -Pq '^[a-z]+(_[a-z]+)+$') &&
     ! $(echo "$1" | grep -Pq '^[a-z]+$'); then
        echo "Wrong app name. Use only lower case letters, and use _ to separate words inside the name."
        return 2
  fi
}

normalize_required_modules () {
  local modules_input="$1"
  local normalized=""
  local module=""

  IFS=',' read -ra modules <<< "$modules_input"
  for module in "${modules[@]}"; do
    module=$(echo "$module" | xargs)
    if [ -z "$module" ]; then
      continue
    fi
    if [ -n "$normalized" ]; then
      normalized="${normalized},"
    fi
    normalized="${normalized}${module}"
  done

  echo "$normalized"
}

build_required_modules_tuple () {
  local modules_csv="$1"
  local tuple=""
  local module=""

  IFS=',' read -ra modules <<< "$modules_csv"
  for module in "${modules[@]}"; do
    if [ -z "$module" ]; then
      continue
    fi
    if [ -n "$tuple" ]; then
      tuple="${tuple}, "
    fi
    tuple="${tuple}\"${module}\""
  done

  if [ -z "$tuple" ]; then
    echo "()"
  elif [[ "$tuple" != *,* ]]; then
    echo "(${tuple},)"
  else
    echo "(${tuple})"
  fi
}

build_import_lines () {
  local modules_csv="$1"
  local imports=""
  local module=""

  IFS=',' read -ra modules <<< "$modules_csv"
  for module in "${modules[@]}"; do
    if [ -z "$module" ]; then
      continue
    fi
    imports="${imports}import ${module}  # noqa: E402\n"
  done

  printf "%b" "$imports"
}

build_class_name () {
  local app_name="$1"
  local class_name=""
  local word=""

  IFS='_' read -ra words <<< "$app_name"
  for word in "${words[@]}"; do
    class_name="${class_name}${word^}"
  done

  echo "${class_name}App"
}

echo -e "\nWOW, you are going to create a Python periodic plugin for DLS2!\n"
info

echo -n "App name: "
read APP_NAME
check_app_name "$APP_NAME"
if [[ $? == 2 ]]; then
  exit 1
fi

echo -n "Required message modules (comma-separated, leave empty if none): "
read REQUIRED_MODULES_INPUT
REQUIRED_MODULES=$(normalize_required_modules "$REQUIRED_MODULES_INPUT")
REQUIRED_MODULES_TUPLE=$(build_required_modules_tuple "$REQUIRED_MODULES")
IMPORT_LINES=$(build_import_lines "$REQUIRED_MODULES")
APP_CLASS_NAME=$(build_class_name "$APP_NAME")

APP_DIR="./${APP_NAME}"
APP_NAME_UPPER=$(echo "$APP_NAME" | tr '[:lower:]' '[:upper:]')

if [ -e "$APP_DIR" ]; then
  echo "Path ${APP_DIR} already exists. Choose another app name or remove the existing path."
  exit 1
fi

mkdir -p "${APP_DIR}/plugin/config" "${APP_DIR}/python" "${APP_DIR}/cmake"

cat > "${APP_DIR}/CMakeLists.txt" <<EOF
cmake_minimum_required(VERSION 3.15)

set(PLUGIN_NAME ${APP_NAME})

project(\${PLUGIN_NAME})

add_compile_options("-std=c++2a")

find_package(Python3 REQUIRED COMPONENTS Interpreter)

execute_process(
    COMMAND
        \${Python3_EXECUTABLE} -c "import sysconfig; schemes = sysconfig.get_scheme_names(); scheme = 'deb_system' if 'deb_system' in schemes else sysconfig.get_default_scheme(); print(sysconfig.get_path('purelib', scheme=scheme))"
    OUTPUT_VARIABLE
        ${APP_NAME_UPPER}_DLS_PYTHON_ROOT
    OUTPUT_STRIP_TRAILING_WHITESPACE
)

file(READ version.txt PROJECT_VERSION)
string(REPLACE "." ";" VERSION_ARRAY \${PROJECT_VERSION})
list(POP_FRONT VERSION_ARRAY
    PROJECT_VERSION_MAJOR
    PROJECT_VERSION_MINOR
    PROJECT_VERSION_PATCH
)
string(REPLACE "\n" "" PROJECT_VERSION_PATCH \${PROJECT_VERSION_PATCH})
string(JOIN "." PROJECT_VERSION
    \${PROJECT_VERSION_MAJOR}
    \${PROJECT_VERSION_MINOR}
    \${PROJECT_VERSION_PATCH}
)
unset(VERSION_ARRAY)
message(STATUS "\${PLUGIN_NAME} PROJECT VERSION \${PROJECT_VERSION}")

if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()

set(CMAKE_SKIP_BUILD_RPATH FALSE)
set(CMAKE_BUILD_WITH_INSTALL_RPATH FALSE)
set(CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)

set(${APP_NAME_UPPER}_SHARED_PYTHON /usr/lib/dls2/python/bin/python3)
set(${APP_NAME_UPPER}_RUNTIME_ROOT /usr/share/\${PLUGIN_NAME})

configure_file(
    cmake/${APP_NAME}.in
    \${CMAKE_CURRENT_BINARY_DIR}/\${PLUGIN_NAME}
    @ONLY
)

install(
    FILES       plugin/config/scheduler.yaml
    DESTINATION /usr/include/dls2/schedulers/
    COMPONENT   \${PROJECT_NAME}
    RENAME      \${PLUGIN_NAME}.yaml
)

install(
    PROGRAMS    \${CMAKE_CURRENT_BINARY_DIR}/\${PLUGIN_NAME}
    DESTINATION /usr/bin
    COMPONENT   \${PROJECT_NAME}
)

install(
    FILES       python/${APP_NAME}.py
    DESTINATION \${${APP_NAME_UPPER}_RUNTIME_ROOT}/python
    PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE
    COMPONENT   \${PROJECT_NAME}
)

set(CPACK_PACKAGE_VERSION_MAJOR             \${PROJECT_VERSION_MAJOR})
set(CPACK_PACKAGE_VERSION_MINOR             \${PROJECT_VERSION_MINOR})
set(CPACK_PACKAGE_VERSION_PATCH             \${PROJECT_VERSION_PATCH})
set(CPACK_DEBIAN_PACKAGE_VERSION            \${PROJECT_VERSION})
set(CPACK_PACKAGE_VENDOR                    "dlslab")
set(CPACK_PACKAGE_CONTACT                   "dlslab")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER         "dlslab")
set(CPACK_VERBATIM_VARIABLES                ON)
set(CPACK_GENERATOR                         "DEB")
set(CPACK_DEB_COMPONENT_INSTALL             ON)
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS          ON)

string(TOUPPER \${PROJECT_NAME} COMPONENT_NAME)

set(CPACK_DEBIAN_\${COMPONENT_NAME}_PACKAGE_NAME          "dls-\${PROJECT_NAME}" CACHE INTERNAL "")
set(CPACK_DEBIAN_\${COMPONENT_NAME}_FILE_NAME             "dls-\${PROJECT_NAME}-\${PROJECT_VERSION}.deb" CACHE INTERNAL "")
set(CPACK_DEBIAN_\${COMPONENT_NAME}_PACKAGE_DEPENDS       "dls2-runtime" CACHE INTERNAL "")

set(CPACK_DEBIAN_\${COMPONENT_NAME}_DEV_PACKAGE_NAME      "dls-\${PROJECT_NAME}-dev" CACHE INTERNAL "")
set(CPACK_DEBIAN_\${COMPONENT_NAME}_DEV_FILE_NAME         "dls-\${PROJECT_NAME}-dev-\${PROJECT_VERSION}.deb" CACHE INTERNAL "")
set(CPACK_DEBIAN_\${COMPONENT_NAME}_DEV_PACKAGE_DEPENDS   "dls2-dev, dls-\${PROJECT_NAME}" CACHE INTERNAL "")

get_cmake_property(CPACK_COMPONENTS_ALL COMPONENTS)
list(REMOVE_ITEM CPACK_COMPONENTS_ALL "Unspecified")

include(CPack)
EOF

cat > "${APP_DIR}/cmake/${APP_NAME}.in" <<EOF
#!/bin/bash
set -eo pipefail

export PYTHONPATH="@${APP_NAME_UPPER}_DLS_PYTHON_ROOT@\${PYTHONPATH:+:\$PYTHONPATH}"
RUNTIME_ROOT="@${APP_NAME_UPPER}_RUNTIME_ROOT@"

PREFERRED_DLS2_PYTHON="\${DLS2_PYTHON:-@${APP_NAME_UPPER}_SHARED_PYTHON@}"
DLS2_PYTHON="\$PREFERRED_DLS2_PYTHON"
if [ ! -x "\$DLS2_PYTHON" ]; then
    echo "${APP_NAME}: missing shared DLS2 interpreter at \$DLS2_PYTHON" >&2
    exit 127
fi
PYTHON_EXECUTABLE="\$DLS2_PYTHON"

DLS_SETUP_SCRIPT="@${APP_NAME_UPPER}_DLS_PYTHON_ROOT@/dls2_py/scripts/setup.sh"
if [ -f "\$DLS_SETUP_SCRIPT" ]; then
    # shellcheck disable=SC1090
    export COLCON_PYTHON_EXECUTABLE="\${COLCON_PYTHON_EXECUTABLE:-\$PYTHON_EXECUTABLE}"
    export COLCON_TRACE="\${COLCON_TRACE:-}"
    export AMENT_TRACE_SETUP_FILES="\${AMENT_TRACE_SETUP_FILES:-}"
    source "\$DLS_SETUP_SCRIPT"
fi

exec "\$PYTHON_EXECUTABLE" "\$RUNTIME_ROOT/python/${APP_NAME}.py" "\$@"
EOF

cat > "${APP_DIR}/plugin/config/scheduler.yaml" <<'EOF'
# Attributes for SCHED_DEADLINE policy
period : 10 # ms, setting sched_period. This is the desired periodicity of the process
runtime_factor : 1 # used to compute sched_runtime = period * runtime_factor. The sched_runtime attribute is usually set to the average computation time (or worst-case execution time for hard real-time tasts)
deadline_factor : 1 # used to compute sched_deadline = period * deadline_factor. The sched_deadline attribute is a time window, starting from the beginning of the period, when sched_runtime microseconds are available to execute the task.
EOF

cat > "${APP_DIR}/python/${APP_NAME}.py" <<EOF
#!/usr/bin/env python3

from __future__ import annotations

import time

from dls2_py.env_bootstrap import setup_environment


APP_ID = "${APP_NAME}"
SIGNALS_DOMAIN = 3

PeriodicAppPlugin = setup_environment(
    package_name=APP_ID,
    module_file=__file__,
    required_message_modules=${REQUIRED_MODULES_TUPLE},
)

${IMPORT_LINES}

class ${APP_CLASS_NAME}(PeriodicAppPlugin):
    def __init__(self) -> None:
        super().__init__(APP_ID, SIGNALS_DOMAIN)
        self._last_report_time = 0.0

        # Example:
        # self.reader_example = self.build_input(
        #     "rt/input_topic",
        #     SomeMessage.SomeMessagePubSubType(),
        #     SomeMessage.SomeMessage(),
        #     required_on_activation=False,
        # )
        #
        # self.writer_example = self.build_output(
        #     "rt/output_topic",
        #     SomeOtherMessage.SomeOtherMessagePubSubType(),
        #     SomeOtherMessage.SomeOtherMessage(),
        # )

    def check_activation(self) -> bool:
        return True

    def deactivation(self, timestamp_ns: int) -> bool:
        del timestamp_ns
        return True

    def run(self, timestamp_ns: int) -> None:
        now = time.time()
        if now - self._last_report_time >= 1.0:
            self._last_report_time = now
            print(f"[{APP_ID}] periodic app running")

        # Add your periodic logic here.
        # Example:
        # self.read()
        # self.writer_example.write()


def main() -> None:
    app = ${APP_CLASS_NAME}()
    app.execute()


if __name__ == "__main__":
    main()
EOF

cat > "${APP_DIR}/requirements.txt" <<'EOF'
# Add package-specific Python dependencies here, one per line.
EOF

cat > "${APP_DIR}/version.txt" <<'EOF'
0.0.1
EOF

chmod +x \
  "${APP_DIR}/cmake/${APP_NAME}.in" \
  "${APP_DIR}/python/${APP_NAME}.py"

echo
echo "Created Python periodic plugin skeleton in ${APP_DIR}"
echo "Files:"
echo "  ${APP_DIR}/CMakeLists.txt"
echo "  ${APP_DIR}/cmake/${APP_NAME}.in"
echo "  ${APP_DIR}/plugin/config/scheduler.yaml"
echo "  ${APP_DIR}/python/${APP_NAME}.py"
echo "  ${APP_DIR}/requirements.txt"
echo "  ${APP_DIR}/version.txt"
