#include "dls2/core_framework/console_layer.hpp"

namespace dls
{
	static std::vector<std::string> vocabulary{"zero", "Three", "one", "two", "thra"};

	ConsoleLayer::ConsoleLayer(std::string ID) : Layer(ID)
	{
		command_manager.addCommand<>
		(
			"list",
			"Show the console commands relative to all the running processes (or just to a specific running one)",
			std::function<bool(std::string)>([&](std::string specific_process = std::string())->bool
			{
				auto console_commands = command_manager.getCommandsList();

				// Temporary map to store the multimap elements
				std::map<std::string, std::set<std::string>> commands_map{};

				// Store the multimap elements in the map by key (generic process) and values (set of commands relative to the process)
				for (auto elem : console_commands)
				{
					commands_map[elem.second].insert(elem.first);
				}

				if(!specific_process.empty())
				{
					// If the selected process for which you want to see the commands is not available (or does not exist)
					if(commands_map.find(specific_process) == commands_map.end())
					{
						std::cout << "Command list request for a wrong or unavailable process" << std::endl;
						return true;
					}
					// Show commands of the selected process, sorted by values
					std::cout << "\n" << specific_process << "::" << std::endl;

					for(const auto& command : commands_map[specific_process])
					{
						std::cout << " * " << command << std::endl;
					}
				}
				else
				{
					// Show commands of the different processes, sorted by key and values
					for(const auto& process : commands_map)
					{
						std::cout << "\n" << process.first << "::" << std::endl;

						for(const auto& command : process.second)
						{
							std::cout << " * " << command << std::endl;
						}
					}
				}

				std::cout << std::endl;

				commands_map.clear();

				return true;
			}),
			{{0,0}},
			true
		);

		command_manager.addCommand<>
		(
			"cleanSharedMemory",
			"Clean Fast-DDS shared memory files",
			std::function<bool()>([&]()->bool
			{
				if(system("sudo fastdds shm clean")){};
				return true;
			}),
			{{0,0}},
			true
		);
	}

	ConsoleLayer::~ConsoleLayer(){}

	// It will generate possible matches corresponding to the partial input entered by the user.
	char **ConsoleLayer::command_completion(const char *text, int start, int end)
	{
	    rl_attempted_completion_over = 1;

		// It calls the command_generator function repeatedly until it (command_generator) returns a null pointer.
		// The command_generator function returns a match one at a time.
		// The rl_completion_matches function returns the array of all those matches.
	    return rl_completion_matches(text, command_generator);
	}

	// It takes the partial input entered by the user and a state as arguments.
	// The state is zero the first time the function is called for a partial input and non-zero otherwise.
	char *ConsoleLayer::command_generator(const char *text, int state)
	{
		// It contains all the matches generated when the function was called the first time on the partial input.
		// In subsequent calls, the string whose index is "match_index" in "matches" vector is returned.
		// The matches are generated by comparing the partial input with the words in the vocabulary.
		static std::vector<std::string> matches{};
		static size_t match_index{0};

		if (state == 0)
		{
			matches.clear();
			match_index = 0;

			std::string textstr(text);
			for (auto word : vocabulary)
			{
				if (word.size() >= textstr.size() &&
					word.compare(0, textstr.size(), textstr) == 0)
				{
					matches.push_back(word);
				}
			}
		}

		if (match_index >= matches.size()) { return nullptr; }
		else { return strdup(matches[match_index++].c_str()); }
	}

	AppStatus ConsoleLayer::run()
	{
		// TODO: Remove this
		// std::this_thread::sleep_for(std::chrono::milliseconds(20));
		// auto ret = command_manager.callCommand("list", {""}, getID());

		while(!this->should_quit)
		{
    		rl_attempted_completion_function = command_completion;

			// The line "readline" returns is allocated with malloc.
			// You should free the line when you are done with it
			char *line = readline("> ");

			if (line != nullptr)
			{
				std::string command = std::string(line);

				// It adds the commands to the history buffer of a console session.
				// They will be accessible by the user using up/down arrow keys
			    if (command.size() > 0) { add_history(line); }

				free(line);

				//std::stringstream ss_command(command);
			    //ss_command >> command;

				std::this_thread::sleep_for(std::chrono::milliseconds(50));
			}
		}
		return getStatus();
	}

	AppStatus ConsoleLayer::stop()
	{
		this->should_quit = true;
		return getStatus();
	}

