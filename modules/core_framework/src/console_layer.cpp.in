ConsoleLayer::~ConsoleLayer(){
};

// =============================================================================
// Interface Override
// =============================================================================
// Signal handler for exiting from console
void ConsoleLayer::handle_signals(int){
	abort();
}

ConsoleLayer::Status ConsoleLayer::run()
{
	rl_set_signals();
	signal(SIGINT, this->handle_signals);

	while(!this->should_quit)
	{
		// This calls malloc behind the scenes. Needs to be freed manually
		char *line = readline(this->build_prompt().c_str());

		if(line) // might be nullptr if EOF was sent
		{
			// Convert to cpp line for ease of use
			std::string input(line);
			trim_inplace(&input);

			if(*input.c_str())
			{
				add_history(input.c_str());

				// Parse the arguments
				// the format is [namespace::]command_name [arg1 [arg2...]]
				std::istringstream iss(input);

				std::vector<std::string> input_split(
					std::istream_iterator<std::string>{iss},
					std::istream_iterator<std::string>()
				);

				std::vector<std::string> args(input_split.begin() + 1, input_split.end());

				// find if commands is in form [namespace::]command_name
				size_t namespace_delimiter_index = input_split[0].find("::");

				std::string namespace_name;
				std::string command_name;

				// if the command is of the form namepsace::command_name
				if(namespace_delimiter_index != std::string::npos)
				{
					namespace_name = input_split[0].substr(0, namespace_delimiter_index);
					command_name = input_split[0].substr(namespace_delimiter_index + 2);
				}
				else 
				{
					command_name = input_split[0];
				}

				auto ret = command_manager.callCommand(command_name, args, namespace_name);

				if(ret > 1){
					std::cerr << "Ambiguous overload. Command '"
						<< command_name << "' found in different namespaces."
						<< std::endl;
				}
				else if (ret == 0)
				{
					std::cerr << "Command '" << command_name
						<< "' not found." << std::endl;
				}
				build_prompt();
			}
			free(line);
			std::this_thread::sleep_for(std::chrono::milliseconds(50));
		}
		else // if EOF received
		{
			std::cout << std::endl;
		}
	}
	return getStatus();
}

ConsoleLayer::Status ConsoleLayer::shutdown()
{
	this->should_quit = true;
	return getStatus();
}


void ConsoleLayer::shutdownAll()
{
	CommandSendMsg msg;
	msg.command() = "shutdownAll";

	this->ddslink->sendMessage("commandSender", (void*) &msg);
}

// =============================================================================
// Implementaton
// =============================================================================
std::string ConsoleLayer::build_prompt()
{
	return "> ";
}

// =============================================================================
// Readline
// =============================================================================
//// This namespace contains global variables that should only be used by
//// readline.
////
//// Readline does not provide for passing userdata, therefore it is not possible
//// to get around using some global structures
//namespace readline_globals
//{
//	std::map<std::string, ConsoleLayer::Command>::iterator current_command;
//}

// -----------------------------------------------------------------------------
// Completion chooser
// -----------------------------------------------------------------------------
char **dls::console_completion(const char *text, int start, int /*end*/)
{
	char **matches = nullptr;
	if(start == 0)
	{
		matches = rl_completion_matches(text, command_completion);
	}
	else
	{
		// Find the command name from the entire command line
		std::stringstream ss(rl_line_buffer);
		std::string command_name;
		ss >> command_name;

		// Find the command structure associated with the command name
		auto commands = pInstance->command_manager.getCommandsList();
		auto it = std::find_if(commands.begin(), commands.end(), [&](auto value) { return (text == value.first); });

		if(it != commands.end())
		{
			matches = rl_completion_matches(text, arg_completion);
		}
	}

	return matches;
}

// -----------------------------------------------------------------------------
// Command Completion
// -----------------------------------------------------------------------------
char *dls::command_completion(const char *text, int state)
{

	// Safety check is not currently needed, but putting it now for future
	// robustness
	if(pInstance)
	{
		// if first time this completer is being run
		if(state == 0)
		{
			commands.clear();
			string_length = std::strlen(text);

			auto list = pInstance->command_manager.getCommandsList();

			for(auto elem : list){
				commands.insert(elem.second + "::" + elem.first);
			}

			it_commands = commands.begin();
		}

		// Do command completion
		while(it_commands != commands.cend())
		{
			std::string match_candidate = it_commands->c_str();
			std::string match_candidate_cmdonly = it_commands->substr(it_commands->find("::")+2, it_commands->length());
			++it_commands;

			std::string match = "";
			if (strncmp(match_candidate_cmdonly.c_str(), text, string_length) == 0){
				match = match_candidate_cmdonly;
			}
			else if(strncmp(match_candidate.c_str(), text, string_length) == 0){
				match = match_candidate;
			}

			if (match != ""){
				char *ret_str = static_cast<char *>
				(
					// malloc is required by readline
					// readline will free the string
					malloc(match.size() + 1)
				);
				strcpy(ret_str, match.c_str());
				return ret_str;
			}
		}
	}

	return nullptr;
}

// -----------------------------------------------------------------------------
// Argument Completion
// -----------------------------------------------------------------------------
char *dls::arg_completion(const char * text, int state)
{
	static std::vector<std::string> files;
	static size_t index;

	if(state == 0)
	{
		index = 0;
		files.clear();

		// fill the default completions
		// for
		// (
		// 	const auto &el :
		// 	readline_globals::current_command->second.default_completions
		// )
		// {
		// 	files.push_back(el);
		// }

		std::filesystem::directory_iterator dir_it
			(
				std::filesystem::current_path()
			);

		for(auto &file : dir_it)
		{
			std::string filename(file.path().filename());
			if
			(
				filename.find_first_of("lib") == 0 &&
				filename.find_last_of(".so") == filename.size() - 1
			)
			{
				files.push_back
				(
					// strip "lib" and ".so" from file
					filename.substr(3, filename.size() - 6)
				);
			}
		}
	}

	while(index != files.size())
	{
		auto match_candidate = const_cast<char *>(files[index].c_str());
		++index;
		if(strncmp(match_candidate, text, std::strlen(text)) == 0)
		{
			char *ret_str = static_cast<char *>
			(
				// malloc is required by readline
				// readline will free the string
				malloc
				(
					strlen(match_candidate) + 1
				)
			);
			strcpy(ret_str, match_candidate);
			return ret_str;
		}
	}

	return nullptr;
}

// -----------------------------------------------------------------------------
// Display Completion
// -----------------------------------------------------------------------------
void dls::display_matches (char **matches, int num_matches, int max_length){

	char **strs = matches;
	std::multiset<std::string> strings;
	while (*(++strs))
		strings.insert(std::string(*(strs)));

	// correct strings for the format owner::command
	std::multiset<std::string> corrected_strings;
	for(auto elem : strings){
		if (elem.find("::") != elem.npos){
			corrected_strings.insert(elem);
		}
		else{
			std::multiset<std::string>::iterator idx = commands.begin();
			while (idx != commands.end()){
				if(idx->find(elem) != idx->npos){
					if(corrected_strings.find(*idx) == corrected_strings.end()){
						corrected_strings.insert(*idx);
						break;
					}					
				}
				idx++;
			}
		}
	}

	std::string curOwner = "";
	uint ncols = 0;
	for(auto elem : corrected_strings){
		if (curOwner != elem.substr(0, elem.find("::")+2)){
			curOwner = elem.substr(0, elem.find("::")+2);
			std::cout << std::endl << std::endl  << curOwner << std::endl;
			std::cout << elem.substr(curOwner.size(), elem.length()-1);
			std::cout << "       ";
			ncols = 0;
		}
		else{
			std::cout << elem.substr(curOwner.size(), elem.length()-2);
			if (ncols++ < ncols_completion){
				std::cout << "       ";
			}
			else{
				std::cout << std::endl;
				ncols = 0;
			}
		}		
	}
	std::cout << std::endl;
	rl_reset_line_state();
}

std::string trim(const std::string &s)
{
	std::string ret(s);
	trim_inplace(&ret);
	return ret;
}

std::string &trim_inplace(std::string *const s)
{
	s->erase(0, s->find_first_not_of(" \t\n\r\f\v"));
	s->erase(s->find_last_not_of(" \t\n\r\f\v") + 1);

	return *s;
}