#include "dls2/core_framework/console_layer.hpp"

namespace dls
{
	// Namespace for the GNU Readline functions used to implement the autocompletion with "Tab" key
	namespace readline_completion
	{
		// Forward declaration of Readline functions
		char **command_completion(const char *text, int start, int end);
		char *command_generator(const char *text, int state);
		char *load_layer_argument_generator(const char *text, int state);
		void display_matches(char **matches, int num_matches, int max_length);

		// dls::readline_completion::ConsoleLayer object, visible from Readline functions, pointing to the main dls::ConsoleLayer object
		ConsoleLayer* console_layer = nullptr;

		char **command_completion(const char *text, int start, int end)
		{
			rl_attempted_completion_over = 1;

			char **matches = nullptr;

			// If the match is not complete yet (e.g. "start" is 0 until a match is complete) it calls the 
			// command_generator function repeatedly until it (command_generator) returns a null pointer.
			// The command_generator function returns a match one at a time.
			// The rl_completion_matches function returns the array of all those matches.
			if(start == 0) { matches = rl_completion_matches(text, command_generator); }
			else
			{
				auto load_layers_paths = readline_completion::console_layer->getLoadLayersPaths();
				std::string line(rl_line_buffer);
				std::string load_layer_command = line.substr(0, line.find(" "));

				// When a match is complete (e.g. "start" becomes the size of the line matched + 1 for the last empty space)
				// and the input line contains a load[Layer] command, the load_layer_argument_generator function is 
				// called repeatedly to match the command arguments, only if the line contains "load[Layer]" (with or without 
				// empty space after) or "load[Layer] [something]" and the tab for the argument is not completed yet 
				// (e.g. "start" and "end" parameters are different)
				if(load_layers_paths.find(load_layer_command) != load_layers_paths.end())
				{
					if((line.length() <= load_layer_command.length() + 1) ||
					   ((line.length() > (load_layer_command.length() + 1) && start != end)))
					{
						matches = rl_completion_matches(text, load_layer_argument_generator);
					}
				}
			}

			return matches;
		}

		char *command_generator(const char *text, int state)
		{
			// It contains all the matches generated when the function was called the first time on the partial input.
			// In subsequent calls, the string whose index is "match_index" in "matches" vector is returned.
			// The matches are generated by comparing the partial input with the available commands.
			static std::vector<std::string> matches{};
			static size_t match_index{0};

			auto complete_commands = readline_completion::console_layer->getProcessesAndCommands();

			if (state == 0)
			{
				matches.clear();
				match_index = 0;

				std::string textstr(text);

				for(const auto& process_name : complete_commands)
				{
					for(const auto& command_name : process_name.second)
					{
						auto command = process_name.first;
						command.append("::").append(command_name);

						// Completion for complete command (i.e. "process::command") starting from process name
						if (command.size() >= textstr.size() &&
							command.compare(0, textstr.size(), textstr) == 0)
						{
							matches.push_back(command);
						}
						// Completion for command name without process in front of it
						else if (command_name.size() >= textstr.size() &&
								 command_name.compare(0, textstr.size(), textstr) == 0)
						{
							matches.push_back(command_name);	
						}
					}
				}
			}

			if (match_index >= matches.size()) { return nullptr; }
			else { return strdup(matches[match_index++].c_str()); }
		}

		char *load_layer_argument_generator(const char *text, int state)
		{
			static std::vector<std::string> libraries{};
			static std::vector<std::string> matches{};
			static size_t match_index{0};

			auto load_layers_paths = readline_completion::console_layer->getLoadLayersPaths();

			if(state == 0)
			{
				libraries.clear();
				matches.clear();
				match_index = 0;

				std::string textstr(text);

				std::string line(rl_line_buffer);
				line = line.substr(0, line.find(" "));

				std::filesystem::directory_iterator dir_it(load_layers_paths.at(line));

				for(auto &file : dir_it)
				{
					std::string filename(file.path().filename());
					if(filename.find_first_of("lib") == 0 &&
						filename.find_last_of(".so") == filename.size() - 1)
					{
						libraries.push_back(filename.substr(3, filename.size() - 6));
					}
				}

				for(const auto& lib_name : libraries)
				{
					if (lib_name.size() >= textstr.size() &&
						lib_name.compare(0, textstr.size(), textstr) == 0)
					{
						matches.push_back(lib_name);
					}
				}
			}

			if (match_index >= matches.size()) { return nullptr; }
			else { return strdup(matches[match_index++].c_str()); }
		}
		
		void display_matches(char **matches, int num_matches, int /*max_length*/)
		{
			std::set<std::string> processes_matched{};

			// Fill a set with the names of the processes matched with "Tab" key			
			for (auto it{0}; it<=num_matches; ++it)
			{
				std::string match{matches[it]};

				// If the string matched is not empty
				if(!match.empty())
				{
					std::size_t process_name_end = match.find("::");

					// If the string matched does not finish with "::"
					if(process_name_end != (match.length() - 2))
					{
						auto process_name = match.substr(0, process_name_end);
						processes_matched.insert(process_name);
					}
				}
			}

			auto load_layers_paths = readline_completion::console_layer->getLoadLayersPaths();

			std::string line(rl_line_buffer);

			line.erase(std::remove_if(line.begin(), line.end(), ::isspace),line.end());

			// If the input line contains a "load[Layer]" command, show its possible arguments
			// TODO: Do this check only in the called function (that can may be a unique print probably)
			if(load_layers_paths.find(line) != load_layers_paths.end())
			{
				readline_completion::console_layer->printLoadArguments(line);
			}
			// If the input line does not contain a "load[Layer]" command, show processes and commands matches
			else { readline_completion::console_layer->printProcessesAndCommands(processes_matched); }

			rl_reset_line_state();
		}
	} // namespace readline_completion

	// dls::ConsoleLayer implementation
	ConsoleLayer::ConsoleLayer(std::string ID) : Layer(ID),
												 load_layers_paths_{{"loadController", "${DLS_INSTALL_CONTROLLER_DIR}"},
																	{"loadGenerator", "${DLS_INSTALL_MOTION_GENERATOR_DIR}"},
																	{"loadEstimator", "${DLS_INSTALL_ESTIMATOR_DIR}"},
																	{"loadHardware", "${DLS_INSTALL_HARDWARE_DIR}"},
																	{"loadService", "${DLS_INSTALL_CONTROLLER_DIR}"},	// TODO: Change path (just for debug)
																	{"loadSimulator", "${DLS_INSTALL_SIMULATOR_DIR}"},
																	{"loadModel", "${DLS_INSTALL_MODEL_DIR}"}}
	{
		readline_completion::console_layer = this;

		command_manager.addCommand<>
		(
			"list",
			"Show the console commands relative to all the running processes (or just to a specific running one)",
			std::function<bool()>([&]()->bool
			{
				printProcessesAndCommands();
				return true;
			}),
			{{0,0}},
			true
		);

		command_manager.addCommand<>
		(
			"reset",
			"Reset screen terminal",
			std::function<bool()>([&]()->bool
			{
				return system("reset");
			}),
			{{0,0}},
			true
		);

		command_manager.addCommand<>
		(
			"cleanSharedMemory",
			"Clean Fast-DDS shared memory files",
			std::function<bool()>([&]()->bool
			{
				return system("sudo fastdds shm clean");
			}),
			{{0,0}},
			true
		);
	}

	ConsoleLayer::~ConsoleLayer()
	{
		delete readline_completion::console_layer;
		readline_completion::console_layer = nullptr;
	}

	const std::map<std::string, std::set<std::string>> ConsoleLayer::getProcessesAndCommands(const std::set<std::string>& matches)
	{
		// Get the multimap with all the available commands (not sorted)
		auto commands_multimap = command_manager.getCommandsList();

		std::map<std::string, std::set<std::string>> complete_commands{};

		// Store the multimap elements in the map sorted by key (generic process) and values (set of commands relative to the process)
		for (auto elem : commands_multimap)
		{
			complete_commands[elem.second].insert(elem.first);
		}

		// Get the available commands of specific processes
		if(!matches.empty())
		{
			std::map<std::string, std::set<std::string>> specific_commands{};

			for (auto match = matches.begin(); match != matches.end(); ++match)
			{
				// If the string matched is a process name
				if(complete_commands.find(*match) != complete_commands.end())
				{
					// Insert the process name and all its commands
					specific_commands.insert({*match, complete_commands[*match]});
				}
				// If the string matched is a command name
				else
				{
					for (auto command : complete_commands)
					{
						// If the command exists and its process has been already inserted
						if(command.second.find(*match) != command.second.end() &&
						specific_commands.find(command.first) != specific_commands.end())
						{
							// Insert the command name in the process commands set
							specific_commands[command.first].insert(*match);
						}
						// If the command exists and its process has been already inserted
						else if(command.second.find(*match) != command.second.end() &&
								specific_commands.find(command.first) == specific_commands.end())
						{
							// Insert the process name and a new set with the command name
							specific_commands.insert({command.first, {*match}});
						}
					}
				}
			}

			return specific_commands;
		}
		else { return complete_commands; }
	}

	const std::map<std::string, std::string> ConsoleLayer::getLoadLayersPaths()
	{
		return load_layers_paths_;
	}

	void ConsoleLayer::printProcessesAndCommands(const std::set<std::string>& matches)
	{
		auto processes_and_commands = getProcessesAndCommands(matches);

		std::cout << std::endl;

		for(const auto& process : processes_and_commands)
		{
			std::cout << "\n" << process.first << "::" << std::endl;

			for(const auto& command : process.second)
			{
				std::cout << " * " << command << std::endl;
			}
		}

		std::cout << std::endl;
	}

	void ConsoleLayer::printLoadArguments(const std::string& load_command)
	{
		if(load_layers_paths_.find(load_command) != load_layers_paths_.end())
		{
			std::filesystem::directory_iterator dir_iterator(load_layers_paths_.at(load_command));

			std::cout << "\n" << std::endl;

			for(auto &file : dir_iterator)
			{
				std::string filename(file.path().filename());

				if(filename.find_first_of("lib") == 0 &&
				   filename.find_last_of(".so") == filename.size() - 1)
				{
					std::cout << " * " << filename.substr(3, filename.size() - 6) << std::endl;
				}
			}

			std::cout << std::endl;
		}
	}

	AppStatus ConsoleLayer::run()
	{
		while(!this->should_quit)
		{
    		rl_attempted_completion_function = readline_completion::command_completion;
			rl_completion_display_matches_hook = readline_completion::display_matches;

			// The line "readline" returns is allocated with malloc.
			// You should free the line when you are done with it
			char *line = readline(std::string("> ").c_str());

			if (line != nullptr)
			{
				std::string command(line);
				
				if(*command.c_str())
				{
					// It adds the commands to the history buffer of a console session.
					// They will be accessible by the user using up/down arrow keys
					add_history(command.c_str());

					// Variable that stores the complete input from the user (e.g. "process::command arg1 arg2 ... argN")
					std::istringstream complete_input(command);

					// The complete input is split according to the empty spaces
					std::vector<std::string> complete_input_split(std::istream_iterator<std::string>{complete_input},
																std::istream_iterator<std::string>());

					// Vector that contains only the arguments (e.g. "arg1 arg2 ... argN") of the complete input above
					std::vector<std::string> input_arguments(complete_input_split.begin()+1, complete_input_split.end());

					std::size_t process_name_end = complete_input_split[0].find("::");

					std::string process_name{}, command_name{};

					// If "::" is found in the input and this does not finish with "::"
					if(process_name_end != std::string::npos &&
					   process_name_end != (complete_input_split[0].length() - 2))
					{
						process_name = complete_input_split[0].substr(0, process_name_end);
						command_name = complete_input_split[0].substr(process_name_end + 2);
					}
					else { command_name = complete_input_split[0]; }

					// Call the command associated to the matched "process::command"
					auto ret = command_manager.callCommand(command_name, input_arguments, process_name);

					if(ret > 1)
					{
						std::cerr << "\nCommand found in different processes:" << std::endl;
						std::cout << "-------------------------------------" << std::endl;
						printProcessesAndCommands({command_name});
					}
					else if(ret == 0)
					{
						std::cerr << "\nCommand not found, it might not exist or be ready yet. Available commands:" << std::endl;
						std::cout << "--------------------------------------------------------------------------" << std::endl;
						printProcessesAndCommands();
					}
				}

				free(line);
				std::this_thread::sleep_for(std::chrono::milliseconds(50));
			}
		}
		return getStatus();
	}

	AppStatus ConsoleLayer::stop()
	{
		this->should_quit = true;
		return getStatus();
	}

	std::string ConsoleLayer::where()
	{
		// TODO: Implement
		return "not yet implemented";
	}
