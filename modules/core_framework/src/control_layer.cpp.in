using namespace dls;


int sched_setattr(pid_t pid,
               const struct sched_attr *attr,
               unsigned int flags)
{
    return syscall(__NR_sched_setattr, pid, attr, flags);
}

int sched_getattr(pid_t pid,
               struct sched_attr *attr,
               unsigned int size,
               unsigned int flags)
{
    return syscall(__NR_sched_getattr, pid, attr, size, flags);
}

// =============================================================================
// Constructors
// =============================================================================
ControlLayer::ControlLayer(std::string ID) 
	: AppLayer(ID)
	, controllers()
	, controllers_mutex()
	, gaitMutex()	
	// TODO these 2s should only be put once, and they should be made dynamic
	// ramp for two seconds from 0 to 1
	, pDefault_spline_in(std::make_shared<spline::Ramp<double>> (0, 2, 0, 1))
	// ramp for two seconds from 1 to 0
	, pDefault_spline_out(std::make_shared<spline::Ramp<double>> (0, 2, 1, 0))
	, default_duration_seconds(2)
	, scout(ID)
	, clog(ID)
	, cfatal(ID)
{
    try{
        pRobot = robotlib::RobotFactory::openRobot(Options::robot_name);  
    }
    catch (const std::exception &e)
    {
	    std::cerr << e.what() << std::endl;
    }

	ddsControl = new dls::DDSWriter(
		"ControlLayer::desiredTorques",
		dls::domains::control,
		dls::topics::desired_torques
	);

	ddsMonitor = new dls::DDSWriter(
		"ControlLayer::monitor",
		dls::domains::controllers,
		dls::topics::command_send
	);
	
	command_manager.addCommand<std::string>
	(
		"activateGaitGenerator",
		"activates a gait generator",
		std::function<bool(std::string)>([&](std::string s)->bool
        {
			return this->activateGaitGenerator(s);
		}),
		{{0,1},{2,3}},
		true
	);

	
	command_manager.addCommand<>
	(
		"deactivateGaitGenerator",
		"stops all running gait generators",
		std::function<bool()>([&]()->bool
		{
			this->deactivateGaitGenerator();
            return true;
		}),
		{{1,0},{3,2}},
		true
	);

	command_manager.addCommand<std::string>
	(
		"activateController",
		"activates a controller",
		std::function<bool(std::string s)>([&](const std::string &s)->bool
		{
			return this->activateController(s);
		}),
		{{0,2},{1,3}},
		true
	);


	command_manager.addCommand<std::string>
	(
		"deactivateController",
		"stops a controller",
		std::function<bool(std::string)>([&](std::string s)->bool
		{
			this->deactivateController(s);
            return true;
		}),
		{{2,0},{3,1}},
		true
	);

	command_manager.addCommand<std::string>
	(
		"ls",
		"List components\n"
		"argument:\n"
		"\tcont - list controllers\n"
		"\tgait - list gait generator",

		std::function<bool(std::string)>([&](std::string s)->bool
        {
            if(s == "cont")
            {
                std::stringstream ss;
                // std::lock_guard<std::mutex> lock(this->controllers_mutex);
                size_t i = 0;
                for
                (
                    auto it = this->controllers.cbegin();
                    it != this->controllers.cend();
                    ++it
                )
                {
                    ss << it->first << "\n";
                    ++i;
                }
                if(i) this->scout << ss.str() << std::endl;
            }
            else if(s == "gait")
            {
                std::lock_guard<std::mutex> lock(this->gaitMutex);
                if(this->gaitData.proc)
                {
                    scout << this->gaitData.ID	<< std::endl;
                }
            }
            else
            {
                scout << "Error: unrecognised argument" << std::endl;
                return false;
            }

            return true;
		}),
		{},
		true
	);
}

ControlLayer::~ControlLayer()
{
	delete ddsControl;
	delete ddsMonitor;
	for(auto pair : this->controllers){
		pair.second = nullptr;
	}

	void *res;
	pthread_join(controlSignalGatherThread, &res);
}

// =============================================================================
// Interface Override Functions
// =============================================================================
ControlLayer::Status ControlLayer::run()
{
	// TODO("spawn nonrealtime thread for user interaction")

	// TODO("Check status of all components in the control layer, take corrective actions if requred")
	setStatus(Status::RUNNING);

	// real-time thread that gather all the control sinals and sends to robot
    pthread_create(&controlSignalGatherThread, NULL, (THREADFUNCPTR) &ControlLayer::controlSignalGather, this);

	while(!this->shouldQuit())
	{
		// TODO this loop should be used to verify the state of the layer and all its controllers		
		std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(500));
	}
	return getStatus();
}


void *ControlLayer::controlSignalGather(void *data)
{

    struct sched_attr attr;
    int ret;
    unsigned int flags = 0;

	memset(&attr, 0, sizeof(struct sched_attr));
	attr.size = sizeof(struct sched_attr);
	attr.sched_policy = SCHED_DEADLINE;

    // Period defined in nanoseconds
	attr.sched_runtime  = 1 * 100 * 1000ULL;
	attr.sched_period   = 1 * 100 * 1000ULL;
	attr.sched_deadline = 1 * 100 * 1000ULL;

    ret = sched_setattr(0, &attr, flags);
    if (ret < 0) {
        perror("sched_setattr");
        exit(-1);
    }

	ControlLayer *layer = (ControlLayer*) data;	

	robotlib::JointState desired_torques(layer->pRobot->makeJointState());

    while (!layer->shouldQuit()) {
        auto now = std::chrono::high_resolution_clock::now();
        auto epoch = std::chrono::time_point_cast<std::chrono::milliseconds>(now).time_since_epoch();

		// Read the control signals
		{
			std::lock_guard<std::mutex> lock(layer->controllers_mutex);

            ControlSignal c_signal(layer->pRobot);
            
			for(auto pair : layer->controllers)
			{
				if(!pair.second->dds_reader) continue;

				c_signal = pair.second->getLastPublishedControlSignal();
				desired_torques = pair.second->premultiplier*c_signal.torques;
			}
		}

    	// Send the desired torques to HAL
		layer->publishDesiredTorques(
			layer->saturateTorques(desired_torques.vec_()),
			std::chrono::duration_cast<std::chrono::microseconds>(epoch).count()
		);

        auto delta = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::high_resolution_clock::now() - now).count();

        if (delta > 9900)
        {
            std::stringstream ss;
		    ss << "Control Layer is probably breaking real-time. Has period of 10 mseconds but spent: " << delta << " useconds ";
  		    // ss << "Control layer published torques " << desired_torques.transpose(); // << std::endl;
		    // std::cout << "\033[F" << "\r" << ss.str() << std::endl;
            std::cout << ss.str() << std::endl;
        }

    	sched_yield();
    }

    return NULL;
}

ControlLayer::Status ControlLayer::shutdown()
{
	deactivateGaitGenerator();

	for(auto pair : this->controllers)
	{
		deactivateController(pair.second);
	}
	
	this->should_quit = true;

	setStatus(Status::STOP);

	return getStatus();
}

std::string ControlLayer::where()
{
	std::stringstream ss;

	// Where Controllers
	{
		// std::lock_guard<std::mutex> lock(this->controllers_mutex);
		if(controllers.size() > 0)
		{
			ss << "Active controllers:\n";
			for(const auto &pair : this->controllers)
			{
				ss << pair.second->ID << "\n";
			}
		}
		else
		{
			ss << "No controllers running\n";
		}
	}
	// Where Gait Generators
	{
		std::lock_guard<std::mutex> lock(this->gaitMutex);
		if(this->gaitData.proc)
		{
			ss << "Active Gait Generator:\n";
			ss << gaitData.ID << "\n";
		}
		else
		{
			ss << "No gait generator running\n";
		}
	}
	// Where Desired Torque
	{
		ss << "Last published torque: "	<< this->getPublishedDesiredTorques().transpose();
	}

	return ss.str();

}
// =============================================================================
// Class Implementation Functions
// =============================================================================
// -----------------------------------------------------------------------------
// Controllers
// -----------------------------------------------------------------------------
// TODO("std::map already does this check for emplace, maybe for others. Double check and make this more efficient")
bool ControlLayer::activateController(const std::string &ID)
{
	std::shared_ptr<ControllerData> pData = std::make_shared<ControllerData>(
		this->pRobot,
		this->pDefault_spline_in,
		this->pDefault_spline_out,
		default_duration_seconds,
		default_duration_seconds
	);

	pData->ID = ID;

	decltype(this->controllers.find(ID)) pair_it;
	{
		// std::lock_guard<std::mutex> lock(this->controllers_mutex);

		if(this->controllers.find(ID) != this->controllers.end()) 
			return false;

		// launch the controller
		//
		// since its premultiplier is initially set to zero, this will have
		// no effect on the robot until the spline in is run later
		std::cout << "WARNING hardcoded to hyq" << std::endl;
		char *child_process_launcher = std::getenv("DLS_CHILD_PROCESS_LAUNCHER");
		if(!child_process_launcher)
		{
			std::cerr <<
				"ERROR: env variable DLS_CHILD_PROCESS_LAUNCHER not "
				"defined.  This is probably an error with the launch script"
			<< std::endl;
			return false;
		}

		std::cout << "Launching: child_process_launcher" << std::endl;
		pData->proc = std::make_shared<boost::process::child>(std::vector<std::string>({
			child_process_launcher,
			ID.c_str(),
			"controller",
			Options::robot_name,
			(Options::simulation_mode?"sim":"live")
		}));

		if (pData->proc == nullptr){
			std::cout << "Controller process failed to launch" << std::endl;
			return false;
		}
		// pData->proc->detach();

		pData->dds_reader = std::make_shared<dls::DDSReader>(
			"ControlLayer::Listener::" + ID,
			dls::domains::control,
			dls::topics::control_signal,
			std::function<void(void *)>
			{
				[&](void *tuple)
				{
                    // std::lock_guard<std::mutex> lock(pData->control_signal_mutex);
					ControlSignalMsg msg = *((ControlSignalMsg *)tuple);
					
                    pData->control_signal = msg;
				}
			}
		);

		std::cout << "CONTROL LAYER IS LISTENING CONTROLLER " << ID << " ON TOPIC ControlLayer::Listener::" << ID <<  std::endl;

		this->controllers.emplace(ID, pData);
	}

	// spline in the controller
	//
	// TODO this is copied from the spline out code. Refactor so that it is not
	// repeated
	if(pData->pSpline_in)
	{
		auto start_time = std::chrono::system_clock::now();
		auto end_time = start_time + pData->spline_in_duration;
		auto now = start_time;

		while(now < end_time)
		{
			double running_time =
				(pData->spline_in_duration - std::chrono::duration<double>(end_time - now)).count();

			pData->premultiplier = pData->pSpline_in->eval(running_time);
			now = std::chrono::system_clock::now();

		}
	}

	return true;
}

bool ControlLayer::deactivateController(std::shared_ptr<ControllerData> pData)
{
	// spline down the controller
	if(pData->pSpline_out)
	{
		auto start_time = std::chrono::system_clock::now();
		auto end_time = start_time + pData->spline_out_duration;
		auto now = start_time;

		while(now < end_time)
		{

			double running_time =
				(pData->spline_out_duration - std::chrono::duration<double>(end_time - now)).count();

			pData->premultiplier = pData->pSpline_out->eval(running_time);
			now = std::chrono::system_clock::now();
		}
	}

	std::lock_guard<std::mutex> lock(this->controllers_mutex);

    //shutdown controller over the dds comunication layer
	CommandSendMsg msg;
	msg.name(pData->ID);
	msg.command("shutdown");
	this->ddsMonitor->sendMessage((void*) &msg);

    //wait a little for gait exit
	std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(200));

	if(pData->proc->running()){
		std::cout << "### CONTROLLER IS STILL RUNNING WAITING A LITTLE TO GET PROPPER EXIT ###" << std::endl;
		std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(1000));
		if(pData->proc->running()){
			std::cout << "### FORCING CONTROLLER " << pData->proc->id() << " TO EXIT ###" << std::endl;
			kill(pData->proc->id(), SIGKILL);
		}
	}

	pData->proc = nullptr;
	pData->dds_reader = nullptr;
	this->controllers.erase(pData->ID);

    return false;
}

bool ControlLayer::deactivateController(const std::string &ID)
{
	decltype(this->controllers.find(ID)) pair_it;
	{
		std::lock_guard<std::mutex> lock(this->controllers_mutex);
		pair_it = this->controllers.find(ID);

		if(pair_it == this->controllers.end()) 
			return false;
	}

    return this->deactivateController(pair_it->second);
}

// -----------------------------------------------------------------------------
// Gait Generators
// -----------------------------------------------------------------------------
bool ControlLayer::activateGaitGenerator(const std::string &ID)
{
	std::lock_guard<std::mutex> lock(this->gaitMutex);

	if(this->gaitData.proc != nullptr)
	{
		std::cout << "A gait generator is already running" << std::endl;
		return false;
	}

	// TODO("error checking")

	std::cout << "WARNING hardcoded to hyq" << std::endl;
	this->gaitData.proc = new boost::process::child(std::vector<std::string>({
		#ifndef NDEBUG
			"${EXECUTABLE_OUTPUT_PATH}/child_process_launcher",
		#else
			"${DLS_INSTALL_RUNTIME_DIR}/child_process_launcher",
		#endif
		ID.c_str(),
		"gait_generator",
		Options::robot_name,
		(Options::simulation_mode?"sim":"live")
	}));

	this->gaitData.ID = ID;
	this->gaitData.proc->detach();

	if (this->gaitData.proc == nullptr)
		std::cout << "Failed to launch gait generator process" << std::endl;
	
	return true;
}

void ControlLayer::deactivateGaitGenerator()
{
	std::lock_guard<std::mutex> lock(this->gaitMutex);
	if(this->gaitData.proc != nullptr)
	{
		//shutdown controller over the dds comunication layer
		CommandSendMsg msg;
		msg.name(this->gaitData.ID);
		msg.command("shutdown");
		this->ddsMonitor->sendMessage((void*) &msg);

		//wait a little for gait exit
		std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(200));

		if(this->gaitData.proc->running()){
			std::cout << "### GAIT GENERATOR IS STILL RUNNING WAITING A LITTLE TO GET PROPPER EXIT ###" << std::endl;
			std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(1000));
			if(this->gaitData.proc->running()){
				std::cout << "### FORCING GAIT GENERATOR EXIT ###" << std::endl;
				kill(this->gaitData.proc->id(), SIGTERM);
			}
		}

		delete this->gaitData.proc;
		this->gaitData.proc = nullptr;
	}
}

Eigen::MatrixXd ControlLayer::saturateTorques(const Eigen::MatrixXd &req) const
{
	// TODO("This is not implemented yet")
	// TODO("Move this to the robot class")
	return req;
}

void ControlLayer::publishDesiredTorques(const Eigen::VectorXd &torques, double time) // TODO Change type of time
{
	DesiredTorquesMsg msg;
	msg.desired_torques().resize(torques.size());
	msg.header().time().seconds() = time;
	Eigen::VectorXd::Map(&msg.desired_torques()[0], torques.size()) = torques;

	{
		std::lock_guard<std::mutex>	lock(this->last_published_desired_torques_mutex);
		this->last_published_desired_torques = torques;
	}

	this->ddsControl->sendMessage(&msg);
}

Eigen::VectorXd ControlLayer::getPublishedDesiredTorques(){
	std::lock_guard<std::mutex>	lock(this->last_published_desired_torques_mutex);
	return this->last_published_desired_torques;
}