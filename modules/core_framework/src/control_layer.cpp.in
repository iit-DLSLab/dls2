int sched_setattr(pid_t pid,
               const struct sched_attr *attr,
               unsigned int flags)
{
    return syscall(__NR_sched_setattr, pid, attr, flags);
}

int sched_getattr(pid_t pid,
               struct sched_attr *attr,
               unsigned int size,
               unsigned int flags)
{
    return syscall(__NR_sched_getattr, pid, attr, size, flags);
}

// =============================================================================
// Constructors
// =============================================================================
ControlLayer::ControlLayer(std::string ID) 
	: AppLayer(ID)
	, pDefault_spline_in(std::make_shared<math::Ramp<double>> (0, 2, 0, 1))
	, pDefault_spline_out(std::make_shared<math::Ramp<double>> (0, 2, 1, 0))
	, default_duration_seconds(2)
	, scout(ID)
	, clog(ID)
	, cfatal(ID)
{
    try{
        pRobot = robotlib::RobotFactory::openRobot(Options::robot_name);  
    }
    catch (const std::exception &e)
    {
	    std::cerr << e.what() << std::endl;
    }

	ddsLink = new dls::DDSParticipant(this->getID(), dls::domains::signals);

	ddsLink->addWriter("desiredTorques", dls::topics::desired_torques);
	
	command_manager.addCommand<std::string>
	(
		"loadGenerator",
		"Loads a motion generator",
		std::function<bool(std::string)>([&](std::string s)->bool
        {
			return this->loadMotionGenerator(s);
		}),
		{{0,1},{1,1},{2,3},{3,3}},
		true
	);
	
	command_manager.addCommand<>
	(
		"unloadGenerator",
		"Unload a motion generator",
		std::function<bool(std::string)>([&](std::string s)->bool
		{
			this->unloadMotionGenerator(s);
			if(this->motion_generators.size() > 0)
				return false;
            return true;
		}),
		{{1,0},{3,2}},
		true
	);

	command_manager.addCommand<std::string>
	(
		"loadController",
		"Load a controller",
		std::function<bool(std::string s)>([&](const std::string &s)->bool
		{
			return this->loadController(s);
		}),
		{{0,2},{1,3},{2,2},{3,3}},
		true
	);

	command_manager.addCommand<std::string>
	(
		"unloadController",
		"Unload a controller",
		std::function<bool(std::string)>([&](std::string s)->bool
		{
			return this->unloadController(s);
			if(this->controllers.size() > 0)
				return false;
		}),
		{{2,0},{3,1}},
		true
	);

	command_manager.addCommand<std::string>
	(
		"ls",
		"List components\n"
		"argument:\n"
		"\tcont - list controllers\n"
		"\tmotion - list motion generator",

		std::function<bool(std::string)>([&](std::string s)->bool
        {
            if(s == "cont")
            {
                std::stringstream ss;
                // std::lock_guard<std::mutex> lock(this->controllers_mutex);
                for(auto &elem : this->controllers)
                {
                    ss << elem.first << "\n";
                }
                this->scout << ss.str() << std::endl;
            }
            else if(s == "motion")
            {
				std::stringstream ss;
                // std::lock_guard<std::mutex> lock(this->motion_mutex);
				for(auto &elem : this->motion_generators)
                {
                    ss << elem.first << "\n";
                }
				this->scout << ss.str() << std::endl;
            }
            else
            {
                scout << "Error: unrecognised argument" << std::endl;
                return false;
            }

            return true;
		}),
		{},
		true
	);
}

ControlLayer::~ControlLayer()
{
	delete ddsLink;
	
	for(auto pair : this->controllers){
		pair.second = nullptr;
	}

	void *res;
	pthread_join(controlSignalGatherThread, &res);
}

// =============================================================================
// Interface Override Functions
// =============================================================================
ControlLayer::Status ControlLayer::run()
{
	// TODO("spawn nonrealtime thread for user interaction")

	// TODO("Check status of all components in the control layer, take corrective actions if requred")
	setStatus(Status::RUNNING);

	// real-time thread that gather all the control sinals and sends to robot
    pthread_create(&controlSignalGatherThread, NULL, (THREADFUNCPTR) &ControlLayer::controlSignalGather, this);

	while(!this->shouldQuit())
	{
		// TODO this loop should be used to verify the state of the layer and all its controllers		
		std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(1000));
	}
	return getStatus();
}


void *ControlLayer::controlSignalGather(void *data)
{

    struct sched_attr attr;
    int ret;
    unsigned int flags = 0;

	memset(&attr, 0, sizeof(struct sched_attr));
	attr.size = sizeof(struct sched_attr);
	attr.sched_policy = SCHED_DEADLINE;

    // Period defined in nanoseconds
	attr.sched_runtime  = 1 * 1000 * 1000ULL;
	attr.sched_period   = 1 * 1000 * 1000ULL;
	attr.sched_deadline = 1 * 1000 * 1000ULL;

    ret = sched_setattr(0, &attr, flags);
    if (ret < 0) {
        perror("sched_setattr");
        exit(-1);
    }

	ControlLayer *layer = (ControlLayer*) data;	

	robotlib::JointState desired_torques(layer->pRobot->makeJointState());

    while (!layer->shouldQuit()) {
        auto now = std::chrono::high_resolution_clock::now();
        auto epoch = std::chrono::time_point_cast<std::chrono::milliseconds>(now).time_since_epoch();
		desired_torques = 0;

		// Read the control signals
		{
			// std::lock_guard<std::mutex> lock(layer->controllers_mutex);

            ControlSignal c_signal(layer->pRobot);
            
			for(auto pair : layer->controllers)
			{
				c_signal = pair.second->control_signal.getData();
				desired_torques += pair.second->premultiplier*c_signal.torques;
			}
		}

    	// Send the desired torques to HAL
        if(layer->controllers.size() > 0)
        {
            layer->publishDesiredTorques(
                layer->saturateTorques(desired_torques.vec_()),
                std::chrono::duration_cast<std::chrono::microseconds>(epoch).count()
            );
        }

        auto delta = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::high_resolution_clock::now() - now).count();

        if (delta > 990)
        {
            std::stringstream ss;
		    ss << "Control Layer is probably breaking real-time. Has period of 1 mseconds but spent: " << delta << " useconds ";
  		    // ss << "Control layer published torques " << desired_torques.transpose(); // << std::endl;
		    // scout << "\033[F" << "\r" << ss.str() << std::endl;
            layer->scout << ss.str() << std::endl;
        }

    	sched_yield();
    }

    return NULL;
}

ControlLayer::Status ControlLayer::shutdown()
{
	std::vector<std::string> keys;
	for(auto pair : this->motion_generators)
		keys.push_back(pair.first);
	
	for(auto key : keys)
		this->unloadMotionGenerator(key);

	keys.clear();
	for(auto pair : this->controllers)
		keys.push_back(pair.first);
	
	for(auto key : keys)
		this->unloadController(key);
	
	this->should_quit = true;

	setStatus(Status::STOP);
	return getStatus();
}

std::string ControlLayer::where()
{
	std::stringstream ss;

	// Where Controllers
	{
		// std::lock_guard<std::mutex> lock(this->controllers_mutex);
		if(controllers.size() > 0)
		{
			ss << "Active controllers:\n";
			for(const auto &pair : this->controllers)
			{
				ss << pair.second->getID() << "\n";
			}
		}
		else
		{
			ss << "No controllers running\n";
		}
	}
	// Where Motion Generators
	{
		// std::lock_guard<std::mutex> lock(this->motion_mutex);
		if(motion_generators.size() > 0)
		{
			ss << "Active Motion Generator:\n";
			for(const auto &pair : this->motion_generators)
			{
				ss << pair.second->getID() << "\n";
			}
		}
		else
		{
			ss << "No motion generator running\n";
		}
	}
	// Where Desired Torque
	{
		ss << "Last published torque: "	<< this->getPublishedDesiredTorques().transpose();
	}

	return ss.str();

}
// =============================================================================
// Class Implementation Functions
// =============================================================================
bool ControlLayer::loadController(const std::string& lib_name)
{
	// std::lock_guard<std::mutex> lock(this->controllers_mutex);
	
	if(this->controllers.find(lib_name) != this->controllers.end()) 
        return false;

    std::shared_ptr<ControllerData> pData = std::make_shared<ControllerData>(
		lib_name,
		this->ddsLink,
		dls::topicType(lib_name, new ControlSignalMsgPubSubType()),
		this->pRobot,
		this->pDefault_spline_in,
		this->pDefault_spline_out,
		default_duration_seconds,
		default_duration_seconds
	);

    this->controllers.emplace(pData->getID(), pData);

    pData->proc = std::make_shared<boost::process::child>(std::vector<std::string>({
        "${DLS_INSTALL_RUNTIME_DIR}/child_process_launcher",
        pData->getID(),
		lib_name,
        "controller",
        Options::robot_name,
        (Options::simulation_mode?"sim":"live")
    }));

    if (pData->proc == nullptr){
        scout << "Controller process failed to launch" << std::endl;
        return false;
    }

    scout << "CONTROL LAYER IS LISTENING CONTROLLER " << pData->getID() << " ON TOPIC ControlLayer::Listener::" << pData->getID() <<  std::endl;

	// spline in the controller
	//
	// TODO this is copied from the spline out code. Refactor so that it is not
	// repeated
	if(pData->pSpline_in)
	{
		auto start_time = std::chrono::system_clock::now();
		auto end_time = start_time + pData->spline_in_duration;
		auto now = start_time;

		while(now < end_time)
		{
			double running_time =
				(pData->spline_in_duration - std::chrono::duration<double>(end_time - now)).count();

			pData->premultiplier = pData->pSpline_in->eval(running_time);
			now = std::chrono::system_clock::now();

		}
	}

	pData->proc->detach();
	return true;
}

bool ControlLayer::unloadController(std::shared_ptr<ControllerData> pData)
{
	// spline down the controller
	if(pData->pSpline_out)
	{
		auto start_time = std::chrono::system_clock::now();
		auto end_time = start_time + pData->spline_out_duration;
		auto now = start_time;

		while(now < end_time)
		{
			double running_time =
				(pData->spline_out_duration - std::chrono::duration<double>(end_time - now)).count();

			pData->premultiplier = pData->pSpline_out->eval(running_time);
			now = std::chrono::system_clock::now();
		}
	}

	// std::lock_guard<std::mutex> lock(this->controllers_mutex);

	command_manager.callCommand("exit", {}, pData->getID());

    //wait a little for motion exit
	std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(1000));

	if(pData->proc->running()){
		scout << "### CONTROLLER IS STILL RUNNING WAITING A LITTLE TO GET PROPPER EXIT ###" << std::endl;
		std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(1000));
		if(pData->proc->running()){
			scout << "### FORCING CONTROLLER " << pData->proc->id() << " TO EXIT ###" << std::endl;
			kill(pData->proc->id(), SIGKILL);
		}
	}

	pData->proc = nullptr;
	this->controllers.erase(pData->getID());

	//Remove the dataReader associated to pData (this allows to reload the same controller)
	this->ddsLink->deleteReader(pData->getID());

	std::cout << "UNLOADED CONTROLLER " << pData->getID() << std::endl;

    return true;
}

bool ControlLayer::unloadController(const std::string &ID)
{
	decltype(this->controllers.find(ID)) pair_it;
	{
		// std::lock_guard<std::mutex> lock(this->controllers_mutex);
		pair_it = this->controllers.find(ID);

		if(pair_it == this->controllers.end()) 
			return false;
	}

    return this->unloadController(pair_it->second);
}

// -----------------------------------------------------------------------------
// Motion Generators
// -----------------------------------------------------------------------------
bool ControlLayer::loadMotionGenerator(const std::string& lib_name)
{
	// std::lock_guard<std::mutex> lock(this->motion_mutex);

	if(this->motion_generators.find(lib_name) != this->motion_generators.end()) 
        return false;

	std::shared_ptr<AppData> pData = std::make_shared<AppData>(lib_name);

	this->motion_generators.emplace(pData->getID(), pData);

	pData->proc = std::make_shared<boost::process::child>(std::vector<std::string>({
		"${DLS_INSTALL_RUNTIME_DIR}/child_process_launcher",
		lib_name,
		lib_name,
		"motion_generator",
		Options::robot_name,
		(Options::simulation_mode?"sim":"live")
	}));

    if (pData->proc == nullptr){
        scout << "Failed to launch motion generator process" << std::endl;
	    return false;
    }

	pData->proc->detach();	
	return true;
}

bool ControlLayer::unloadMotionGenerator(std::shared_ptr<AppData> pData)
{
	// std::lock_guard<std::mutex> lock(this->motion_mutex);

	//shutdown controller over the dds comunication layer
	command_manager.callCommand("exit", {}, pData->getID());

	// wait a little for motion exit
	std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(1000));

	if(pData->proc->running()){
		scout << "### MOTION GENERATOR IS STILL RUNNING WAITING A LITTLE TO GET PROPPER EXIT ###" << std::endl;
		std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(1000));
		if(pData->proc->running()){
			scout << "### FORCING MOTION GENERATOR EXIT ###" << std::endl;
			kill(pData->proc->id(), SIGKILL);
		}
	}

	pData->proc = nullptr;
	this->motion_generators.erase(pData->getID());
	return true;
}

bool ControlLayer::unloadMotionGenerator(const std::string& ID)
{
	// std::lock_guard<std::mutex> lock(this->motion_mutex);

	auto pair_it = this->motion_generators.find(ID);
	
	if(pair_it == this->motion_generators.end()) 
		return false;
	
    return this->unloadMotionGenerator(pair_it->second);
}

Eigen::MatrixXd ControlLayer::saturateTorques(const Eigen::MatrixXd &req) const
{
	// TODO("This is not implemented yet")
	// TODO("Move this to the robot class")
	return req;
}

void ControlLayer::publishDesiredTorques(const Eigen::VectorXd &torques, double time) // TODO Change type of time
{
	DesiredTorquesMsg msg;
	msg.time() = time;
	Eigen::VectorXd::Map(&msg.desired_torques()[0], torques.size()) = torques;

	{
		// std::lock_guard<std::mutex>	lock(this->last_published_desired_torques_mutex);
		this->last_published_desired_torques = torques;
	}

	this->ddsLink->sendMessage("desiredTorques", &msg);
}

Eigen::VectorXd ControlLayer::getPublishedDesiredTorques(){
	// std::lock_guard<std::mutex>	lock(this->last_published_desired_torques_mutex);
	return this->last_published_desired_torques;
}