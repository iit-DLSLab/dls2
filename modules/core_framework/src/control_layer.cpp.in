int sched_setattr(pid_t pid,
               const struct sched_attr *attr,
               unsigned int flags)
{
    return syscall(__NR_sched_setattr, pid, attr, flags);
}

int sched_getattr(pid_t pid,
               struct sched_attr *attr,
               unsigned int size,
               unsigned int flags)
{
    return syscall(__NR_sched_getattr, pid, attr, size, flags);
}

// =============================================================================
// Constructors
// =============================================================================
ControlLayer::ControlLayer(std::string ID, std::string robot_name) 
	: Layer(ID, 1000)
	, ddsSignalLink(std::make_shared<dls::DDSParticipant>(ID, dls::domains::signals))
	, pDefault_spline_in(std::make_shared<math::Ramp<double>> (0, 2, 0, 1))
	, pDefault_spline_out(std::make_shared<math::Ramp<double>> (0, 2, 1, 0))
	, default_duration_seconds(2)
	, pRobot(robotlib::RobotFactory::openRobot(robot_name))
	, writer_control_signal(
		ddsSignalLink, 
		dls::topics::desired_torques)
	, torques()
	, clog(ID)
	, cfatal(ID)
{
	writer_control_signal.msg.desired_torques().resize(pRobot->getNJOINTS());
	torques.desired_torques().resize(pRobot->getNJOINTS());
	command_manager.addCommand<std::string>
	(
		"loadGenerator",
		"Loads a motion generator",
		std::function<bool(std::string)>([&](std::string s)->bool
        {
			return this->loadMotionGenerator(s);
		}),
		{{0,1},{1,1},{2,3},{3,3}},
		true
	);
	
	command_manager.addCommand<>
	(
		"unloadGenerator",
		"Unload a motion generator",
		std::function<bool(std::string)>([&](std::string s)->bool
		{
			if(this->unloadMotionGenerator(s) && this->motion_generators.size() == 0)
				return true;
			else // either the unload was not successful or there are still motion generators running
				return false;
		}),
		{{1,0},{3,2}},
		true
	);

	command_manager.addCommand<std::string>
	(
		"loadController",
		"Load a controller",
		std::function<bool(std::string s)>([&](const std::string &s)->bool
		{
			return this->loadController(s);
		}),
		{{0,2},{1,3},{2,2},{3,3}},
		true
	);

	command_manager.addCommand<std::string>
	(
		"loadExternalController",
		"Load an external controller",
		std::function<bool(std::string s)>([&](const std::string &s)->bool
		{
			return this->loadExternalController(s);
		}),
		{{0,2},{1,3},{2,2},{3,3}},
		true
	);

	command_manager.addCommand<std::string>
	(
		"unloadController",
		"Unload a controller",
		std::function<bool(std::string)>([&](std::string s)->bool
		{
			if(this->unloadController(s) && this->controllers.size() == 0)
				return true;
			else // either the unload was not successful or there are still controllers running
				return false;
		}),
		{{2,0},{3,1}},
		true
	);

	command_manager.addCommand<std::string>
	(
		"unloadExternalController",
		"Unload an external controller",
		std::function<bool(std::string)>([&](std::string s)->bool
		{
			if(this->unloadExternalController(s) && this->controllers.size() == 0)
				return true;
			else // either the unload was not successful or there are still controllers running
				return false;
		}),
		{{2,0},{3,1}},
		true
	);

	command_manager.addCommand<std::string>
	(
		"ls",
		"List components\n"
		"argument:\n"
		"\tcont - list controllers\n"
		"\tmotion - list motion generator",

		std::function<bool(std::string)>([&](std::string s)->bool
        {
            if(s == "cont")
            {
                std::stringstream ss;
                // std::lock_guard<std::mutex> lock(this->controllers_mutex);
				ss << "\n";
                for(auto &elem : this->controllers)
                {
                    ss << elem.first << "\n";
                }
                this->scout_sys << ss.str() << std::endl;
            }
            else if(s == "motion")
            {
				std::stringstream ss;
                // std::lock_guard<std::mutex> lock(this->motion_mutex);
				ss << "\n";
				for(auto &elem : this->motion_generators)
                {
                    ss << elem.first << "\n";
                }
				this->scout_sys << ss.str() << std::endl;
            }
            else
            {
                scout_err << "Error: unrecognised argument" << std::endl;
                return false;
            }

            return true;
		}),
		{},
		true
	);
}

ControlLayer::~ControlLayer()
{
	for(auto pair : this->controllers){
		pair.second = nullptr;
	}

	void *res = nullptr; // do not need to save the thread exit status
	pthread_join(controlSignalGatherThread, &res);
}

// =============================================================================
// Interface Override Functions
// =============================================================================
bool ControlLayer::checkActivation(){
	// no check is done: can always be activated
	// spawn real-time thread that gather all the control sinals and sends to robot
    pthread_create(&controlSignalGatherThread, NULL, (THREADFUNCPTR) &ControlLayer::controlSignalGather, this);
	return true;
}

void *ControlLayer::controlSignalGather(void *data)
{

    struct sched_attr attr;
    int ret;
    unsigned int flags = 0;

	memset(&attr, 0, sizeof(struct sched_attr));
	attr.size = sizeof(struct sched_attr);
	attr.sched_policy = SCHED_DEADLINE;

    // Period defined in nanoseconds
	attr.sched_runtime  = 1000000ULL;
	attr.sched_period   = 1000000ULL;
	attr.sched_deadline = 1000000ULL;

    ret = sched_setattr(0, &attr, flags);
    if (ret < 0) {
        perror("sched_setattr");
        exit(-1);
    }

	ControlLayer *layer = (ControlLayer*) data;	
	boost::circular_buffer<int> delta(100);

    while(!layer->sm.isRaised(layer->sm.deactivation_request) &&  !layer->sm.isRaised(layer->sm.quit_request)) {
        auto now = std::chrono::high_resolution_clock::now();
        auto epoch = std::chrono::time_point_cast<std::chrono::milliseconds>(now).time_since_epoch();

		// Read the control signals
		std::fill(layer->torques.desired_torques().begin(), layer->torques.desired_torques().end(), 0);
		
		for(auto pair : layer->controllers)
		{
			pair.second->reader_control_signal.read();
			for(long unsigned int i=0; i<pair.second->reader_control_signal.msg.torques().size();i++){
				layer->torques.desired_torques()[i] += pair.second->premultiplier * pair.second->reader_control_signal.msg.torques()[i];
			}
		}

    	// Send the desired torques to HAL
		layer->writer_control_signal.msg.desired_torques() = layer->saturateTorques(layer->torques.desired_torques());
		layer->writer_control_signal.msg.timestamp() = std::chrono::duration_cast<std::chrono::microseconds>(epoch).count();
		layer->writer_control_signal.publish();

        delta.push_back(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::high_resolution_clock::now() - now).count());

		double mean{0};
		for (auto const& elem : delta)
      		mean += elem/delta.size();

        if (mean > 990)
	    {
            std::stringstream ss;
		    ss << "Control Layer is probably breaking real-time. Has period of 1 mseconds but spent: " << mean << " useconds ";
  		    // ss << "Control layer published torques " << desired_torques.transpose(); // << std::endl;
		    // scout << "\033[F" << "\r" << ss.str() << std::endl;
            layer->scout_warn << ss.str() << std::endl;
        }

    	sched_yield();
    }

    return NULL;
}

void ControlLayer::monitor()
{
	this->checkAppData(this->controllers);
	this->checkAppData(this->motion_generators);
}

void ControlLayer::close()
{	
	for(auto pair : this->motion_generators)
		this->unloadMotionGenerator(pair.first);
	
	for(auto pair : this->controllers)
		this->unloadController(pair.first);
}

std::string ControlLayer::where()
{
	std::stringstream ss;

	// Where Controllers
	{
		// std::lock_guard<std::mutex> lock(this->controllers_mutex);
		if(controllers.size() > 0)
		{
			ss << "Active controllers:\n";
			for(const auto &pair : this->controllers)
			{
				ss << pair.second->getID() << "\n";
			}
		}
		else
		{
			ss << "No controllers running\n";
		}
	}
	// Where Motion Generators
	{
		// std::lock_guard<std::mutex> lock(this->motion_mutex);
		if(motion_generators.size() > 0)
		{
			ss << "Active Motion Generator:\n";
			for(const auto &pair : this->motion_generators)
			{
				ss << pair.second->getID() << "\n";
			}
		}
		else
		{
			ss << "No motion generator running\n";
		}
	}
	// Where Desired Torque
	{
		std::vector<double> torques = this->getPublishedDesiredTorques();
		ss << "Last published torque: ";
		for(auto t : torques)
			ss << t << " ";
		ss << "\n";		
	}

	return ss.str();

}
// =============================================================================
// Class Implementation Functions
// =============================================================================
bool ControlLayer::loadController(const std::string& lib_name)
{
	// std::lock_guard<std::mutex> lock(this->controllers_mutex);
	
	if(this->controllers.find(lib_name) != this->controllers.end())
	{
		scout_err << "Controller " << lib_name << " already loaded" << std::endl;
        return false;
	}

    std::shared_ptr<ControllerData> pData = std::make_shared<ControllerData>(
		lib_name,
		this->ddsSignalLink,
		dls::topicType(lib_name, new dls2_interface::msg::ControlSignalPubSubType()),
		this->pDefault_spline_in,
		this->pDefault_spline_out,
		default_duration_seconds,
		default_duration_seconds
	);

    pData->proc = std::make_shared<boost::process::child>(std::vector<std::string>({
        "${DLS_INSTALL_RUNTIME_DIR}/child_process_launcher",
        pData->getID(),
		lib_name,
        "controller",
		this->pRobot->getName()
    }));

    if (pData->proc == nullptr){
        scout_err << "Controller " << lib_name <<" failed to launch: nullptr" << std::endl;
        return false;
	}
	// else if (pData->proc->wait_for(std::chrono::duration<double, std::milli>(1500))){
    //     scout_err << "Controller " << lib_name <<" failed to launch: expired timeout" << std::endl;
    //     return false;
    // }

    scout_sys << "CONTROL LAYER IS LISTENING CONTROLLER " << pData->getID() << " ON TOPIC " << pData->getID() <<  std::endl;

	// spline in the controller
	//
	// TODO this is copied from the spline out code. Refactor so that it is not
	// repeated
	// if(pData->pSpline_in)
	// {
	// 	auto start_time = std::chrono::system_clock::now();
	// 	auto end_time = start_time + pData->spline_in_duration;
	// 	auto now = start_time;

	// 	while(now < end_time)
	// 	{
	// 		double running_time =
	// 			(pData->spline_in_duration - std::chrono::duration<double>(end_time - now)).count();

	// 		pData->premultiplier = pData->pSpline_in->eval(running_time);
	// 		now = std::chrono::system_clock::now();

	// 	}
	// }
	pData->proc->detach();
	this->controllers.emplace(pData->getID(), pData);
	return true;
}

bool ControlLayer::loadExternalController(const std::string& lib_name)
{
	if(this->controllers.find(lib_name) != this->controllers.end())
	{
		scout_err << "Controller " << lib_name << " already loaded" << std::endl;
        return false;
	}

    std::shared_ptr<ControllerData> pData = std::make_shared<ControllerData>(
		lib_name,
		this->ddsSignalLink,
		dls::topicType(lib_name, new dls2_interface::msg::ControlSignalPubSubType()),
		this->pDefault_spline_in,
		this->pDefault_spline_out,
		default_duration_seconds,
		default_duration_seconds
	);

    scout_sys << "CONTROL LAYER IS LISTENING CONTROLLER " << pData->getID() << " ON TOPIC " << pData->getID() <<  std::endl;

	this->controllers.emplace(pData->getID(), pData);
	return true;
}


bool ControlLayer::unloadController(std::shared_ptr<ControllerData> pData)
{
	// // spline down the controller
	// if(pData->pSpline_out)
	// {
	// 	auto start_time = std::chrono::system_clock::now();
	// 	auto end_time = start_time + pData->spline_out_duration;
	// 	auto now = start_time;

	// 	while(now < end_time)
	// 	{
	// 		double running_time =
	// 			(pData->spline_out_duration - std::chrono::duration<double>(end_time - now)).count();

	// 		pData->premultiplier = pData->pSpline_out->eval(running_time);
	// 		now = std::chrono::system_clock::now();
	// 	}
	// }

	// std::lock_guard<std::mutex> lock(this->controllers_mutex);

	command_manager.callCommand("shutdown", {}, pData->getID());

	bool unloaded = false;
	if(!utils::wait(std::function<bool()>([&](){
			if(pData->proc->running()){
				return false;
			}
			return true;
		}), 2000, 10, unloaded)){
		std::cout << "### FORCING CONTROLLER " << pData->getID() << " EXIT ###" << std::endl;
		kill(pData->proc->id(), SIGKILL);		
	}

	pData->proc = nullptr;
	this->controllers.erase(pData->getID());

	std::cout << "unloaded controller " << pData->getID() << std::endl;

    return true;
}

bool ControlLayer::unloadController(const std::string &ID)
{
	decltype(this->controllers.find(ID)) pair_it;
	{
		// std::lock_guard<std::mutex> lock(this->controllers_mutex);
		pair_it = this->controllers.find(ID);

		if(pair_it == this->controllers.end()) 
		{
			scout_err << "controller " << ID << " not loaded" << std::endl;
			return false;
		}
	}

    return this->unloadController(pair_it->second);
}

bool ControlLayer::unloadExternalController(const std::string &ID)
{
	decltype(this->controllers.find(ID)) pair_it;
	{
		// std::lock_guard<std::mutex> lock(this->controllers_mutex);
		pair_it = this->controllers.find(ID);

		if(pair_it == this->controllers.end()) 
		{
			scout_err << "controller " << ID << " not loaded" << std::endl;
			return false;
		}
	}

	this->controllers.erase(ID);

	std::cout << "unloaded controller " << ID << std::endl;
    return true;
}

// -----------------------------------------------------------------------------
// Motion Generators
// -----------------------------------------------------------------------------
bool ControlLayer::loadMotionGenerator(const std::string& lib_name)
{
	// std::lock_guard<std::mutex> lock(this->motion_mutex);

	if(this->motion_generators.find(lib_name) != this->motion_generators.end()) 
	{
		scout_err << "motion generation " << lib_name << " already loaded" << std::endl;
        return false;
	}

	std::shared_ptr<AppData> pData = std::make_shared<AppData>(lib_name);

	pData->proc = std::make_shared<boost::process::child>(std::vector<std::string>({
		"${DLS_INSTALL_RUNTIME_DIR}/child_process_launcher",
		lib_name,
		lib_name,
		"motion_generator",
		this->pRobot->getName()
	}));

	if (pData->proc == nullptr){
        scout_err << "Motion generation " << lib_name <<" failed to launch: nullptr" << std::endl;
        return false;
    }

	pData->proc->detach();	
	this->motion_generators.emplace(pData->getID(), pData);
	return true;
}

bool ControlLayer::unloadMotionGenerator(std::shared_ptr<AppData> pData)
{
	// std::lock_guard<std::mutex> lock(this->motion_mutex);

	//shutdown motion generation over the dds comunication layer
	command_manager.callCommand("shutdown", {}, pData->getID());

	// // wait a little for motion exit
	// std::this_thread::sleep_for(std::chrono::duration<double, std::milli>(1000));

	bool unloaded = false;
	if(!utils::wait(std::function<bool()>([&](){
			if(pData->proc->running()){
				return false;
			}
			return true;
		}), 2000, 10, unloaded)){
		std::cout << "### FORCING MOTION GENERATOR " << pData->getID() << " EXIT ###" << std::endl;
		kill(pData->proc->id(), SIGKILL);		
	}

	std::cout<< "Motion generation " << pData->getID() << " is unloaded" << std::endl;

	pData->proc = nullptr;
	this->motion_generators.erase(pData->getID());
	return true;
}

bool ControlLayer::unloadMotionGenerator(const std::string& ID)
{
	// std::lock_guard<std::mutex> lock(this->motion_mutex);

	auto pair_it = this->motion_generators.find(ID);
	
	if(pair_it == this->motion_generators.end()) 
	{
		scout_err << "motion generation " << ID << " is not loaded" << std::endl;
		return false;
	}

	
    return this->unloadMotionGenerator(pair_it->second);
}

std::vector<double> ControlLayer::saturateTorques(const std::vector<double>& req) const
{
	// TODO("This is not implemented yet")
	// TODO("Move this to the robot class")
	return req;
}

std::vector<double> ControlLayer::getPublishedDesiredTorques(){
	// std::lock_guard<std::mutex>	lock(this->last_published_desired_torquesmutex);
	return this->writer_control_signal.msg.desired_torques();
}