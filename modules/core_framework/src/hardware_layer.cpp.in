
#include "dls2/core_framework/hardware_layer.hpp"
#include "dls2/util/utils.hpp"
#include "dls2/class_loader.hpp"
#include "dls2/core_framework/options.hpp"


using namespace dls;


HardwareLayer::HardwareLayer(std::string ID)
	: Layer(ID, 500)
{
    command_manager.addCommand<std::string>
	(
		"loadHardware",
		"Load thel HAL of a robot",
		std::function<bool(std::string)>([&](std::string type)->bool
        {
			return this->loadHardware(type);
        }),
		{{0,1},{1,1}},
		true
	);

    command_manager.addCommand<>
	(
		"unloadHardware",
		"Terminates the HAL of the robot",
		std::function<bool(std::string)>([&](std::string name)->bool
        {
            return this->unloadHardware(name);
		}),
		{{1,1}},
		true
	);

	command_manager.addCommand<>
	(
		"list",
		"Lists all hardware running",
		std::function<bool()>([&]()->bool
        {
            for(auto elem : this->hardwares){
                this->app_logger.info(elem.first);
            }

            return true;
		}),
		{{1,1}},
		true
	);
}

HardwareLayer::~HardwareLayer()
{
	this->app_logger.info("#### HARDWARE INTERFACE OFF ####");
}

bool HardwareLayer::loadHardware(const std::string &lib_name)
{
	// std::lock_guard<std::mutex> lock(this->hardwares_mutex);

	if(this->hardwares.find(lib_name) != this->hardwares.end())
	{
		this->app_logger.error("hardware " + lib_name + " already loaded");
        return false;
	}

	// if(this->hardwares.size() > 0)
	// 	return false;

	std::shared_ptr<HardwareData> pData = std::make_shared<HardwareData>(lib_name);

	// launch the hardware
	pData->proc = std::make_shared<boost::process::child>(std::vector<std::string>({
		"${DLS_INSTALL_RUNTIME_DIR}/child_process_launcher",
		pData->getID(),
		lib_name,
		"hardware",
		pData->getID() // name of scheduler file for this hardware
	}));

	if (pData->proc == nullptr){
		this->app_logger.error("Hardware " + lib_name +" failed to launch: nullptr");
		return false;
	}

	pData->proc->detach();
	this->hardwares.emplace(pData->getID(), pData);

	return true;
}

bool HardwareLayer::unloadHardware(std::shared_ptr<AppData> pData)
{
	// std::lock_guard<std::mutex> lock(this->hardwares_mutex);

    //shutdown hardware over the dds comunication layer
	command_manager.callCommand("shutdown", {}, pData->getID());

	bool unloaded = false;
	if(!utils::wait(std::function<bool()>([&](){
			if(pData->proc->running()){
				return false;
			}
			return true;
		}), 2000, 10, unloaded)){
		this->app_logger.warning("### FORCING HARDWARE " + pData->getID() + " EXIT ###");
		kill(pData->proc->id(), SIGKILL);
	}

	std::cout << "Hardware " << pData->getID() << " is unloaded" << std::endl;

	pData->proc = nullptr;
	this->hardwares.erase(pData->getID());

    return true;
}

bool HardwareLayer::unloadHardware(const std::string &ID)
{
	auto pair_it = this->hardwares.find(ID);

	if(pair_it == this->hardwares.end())
	{
		this->app_logger.error("hardware " + ID + " is not loaded");
		return false;
	}

    return this->unloadHardware(pair_it->second);
}

void HardwareLayer::close()
{
	std::vector<std::string> keys;
	for(auto pair : this->hardwares)
		keys.push_back(pair.first);

	for(auto key : keys)
		this->unloadHardware(key);
}

void HardwareLayer::monitor(){
	this->checkAppData(this->hardwares);
}
