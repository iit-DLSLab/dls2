// =============================================================================
// Constructors
// =============================================================================
AppLayer::AppLayer(const std::string &ID_) 
	: components_mutex()
    , components({})
    , should_quit(false)
    , command_manager(ID_)
	, scout(ID_ + "Log")
    , ID(ID_)
	, ddsLink(ID_, dls::domains::layers)
	, status_mutex()
	, status(Status::INITIALISING)
	
{
	command_manager.addCommand<>
	(
		"exit",
		"Shutdown the " + ID + " layer",
        std::function<bool()>([&]()->bool
        {
			this->shutdown();
            return true;
		}),
		{},
		true
	);

	command_manager.addCommand<>
	(
		"where",
		"Prints the state of " + this->ID,
		std::function<bool()>([&]()->bool
        {
			std::cout << where() << std::endl;
            return true;
		}),
		{},
		true
	);

