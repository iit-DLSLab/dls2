// =============================================================================
// Interface Override
// =============================================================================
// Signal handler for exiting from console
void ROSLayer::handle_signals(int){
	abort();
}

AppLayer::Status ROSLayer::run()
{
	signal(SIGINT, this->handle_signals);

	const pid_t pid = fork();
	if(pid == -1)
	{
		auto error = errno;
		std::cerr << "Could not fork" << std::endl;
		switch(error)
		{
			case EAGAIN:
				std::cout << "Thread limit reached or SCHED_DEADLINE used" << std::endl;
				break;
			case ENOMEM:
				std::cout << "Out of memory" << std::endl;
				break;
		}
	}
	else if(pid == 0)
	{
		auto ret = system("roscore");

		exit(EXIT_SUCCESS);
	}
	else
	{
		prctl(PR_SET_NAME, "roscore_sup");

		while(!*(this->should_quit))
		{
			std::this_thread::sleep_for(std::chrono::milliseconds(50));
		}
		//int pid = getProcIdByName("roscore");
		kill(pid, SIGINT);
		std::this_thread::sleep_for(std::chrono::seconds(1));
	}
	
	return getStatus();
}

AppLayer::Status ROSLayer::shutdown()
{
	*(this->should_quit) = true;
	return getStatus();
}


