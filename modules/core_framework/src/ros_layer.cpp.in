#include "dls2/core_framework/ros_layer.hpp"
#include <signal.h>

// =============================================================================
// Using Declarations
// =============================================================================
using namespace dls;

// =============================================================================
// Constructors
// =============================================================================
ROSLayer::ROSLayer(std::string ID, bool *should_quit_) 
	: AppLayer(ID)
{
	should_quit = should_quit_;

	command_manager.addCommand<void>
	(
		"core_exit",
		"Shutdown the roscore layer",
		std::function<void()>
		(
			[&]()
			{
				this->shutdown();
			}
		),
		0,
		true
	);

	command_manager.addCommand<void>
	(
		"launchSim",
		"Launches the simulation backend",
		std::function<void()>
		{
			[&]()
			{
				launchSim();
			}
		},
		1,
		true
	);

	command_manager.addCommand<void>
	(
		"launchRosCore",
		"Launches the roscore layer",
		std::function<void()>
		(
			[&]()
			{
				launchCore();
			}
		),
		0,
		true
	);

	command_manager.addCommand<int>
	(
		"freezeBase",
		"puts the robot down in simulation",
		std::function<int()>
		{
			[&]()
			{
				return system("rosservice call /hyq/freeze_base");
			}
		},
		1,
		true
	);

	// command_manager.addCommand<void, std::string>
	// (
	// 	"HyQApp_server",
	// 	"launchLayer",

	// 	"Launches a layer specified by its argument:\n"
	// 	"* hardware\n"
	// 	"* console\n"
	// 	"* control\n"
	// 	"* log",

	// 	std::function<void(std::string)>
	// 	(
	// 		[&](std::string s)
	// 		{
	// 			if(s == "hardware") forkLayer<HardwareLayer>("hardware_layer", argv);
	// 			else if(s == "console") forkLayer<ConsoleLayer>("console_layer", argv);
	// 			else if(s == "control") forkLayer<ControlLayer>("control_layer", argv);
	// 			else if(s == "log") forkLayer<LogLayer>("log_layer", argv);
	// 		}
	// 	)
	// );




}

// =============================================================================
// Interface Override
// =============================================================================
// Signal handler for exiting from console
void ROSLayer::handle_signals(int){
	abort();
}

AppLayer::Status ROSLayer::run()
{
	while(!*(this->should_quit))
	{
		std::this_thread::sleep_for(std::chrono::milliseconds(50));
	}
	
	for (auto elem : this->processes){
		kill(elem.second->id(), SIGINT);	
	}

	this->processes.clear();

	std::this_thread::sleep_for(std::chrono::seconds(1));
	return getStatus();
}


AppLayer::Status ROSLayer::shutdown()
{
	*(this->should_quit) = true;
	return getStatus();
}


void ROSLayer::launchSim()
{
	this->processes.insert({"simulation", new boost::process::child("roslaunch robot_bringup hyq.launch")});	
}

void ROSLayer::launchCore()
{
	this->processes.insert({"roscore", new boost::process::child("roscore")});
}
