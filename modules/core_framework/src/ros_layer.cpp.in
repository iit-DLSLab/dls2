// =============================================================================
// Interface Override
// =============================================================================
// Signal handler for exiting from console
void ROSLayer::handle_signals(int){
	abort();
}

AppLayer::Status ROSLayer::run()
{
	boost::process::child c("roscore");

	while(!*(this->should_quit))
	{
		std::this_thread::sleep_for(std::chrono::milliseconds(50));
	}
	
	kill(c.id(), SIGINT);	
	std::this_thread::sleep_for(std::chrono::seconds(1));
	return getStatus();
}


AppLayer::Status ROSLayer::shutdown()
{
	*(this->should_quit) = true;
	return getStatus();
}


