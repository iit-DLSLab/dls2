// =============================================================================
// Includes
// =============================================================================
// arguments to this program are:
//
// * component name                - name of the component to load
// * <controller | motion_generator> - the type of the component to load A
// * <hyq | hyqreal>               - the robot for which this component is loaded
#include <iostream>
#include <cstdlib>
#include <memory>
#include <string>
#include <csignal>
#include <sstream>
#include <sys/prctl.h>

#include "dls2/class_loader.hpp"
#include "dls2/motion_generator/motion_generator.hpp"
#include "dls2/controller/controller.hpp"
#include "dls2/hardware/hardware.hpp"
#include "dls2/estimator/estimator.hpp"
#include "dls2/service/service_base.hpp"
#include "dls2/log/log.hpp"
#include "dls2/application/layer.hpp"

#include "robotlib/robot_factory.hpp"

// =============================================================================
// Using Declarations
// =============================================================================
using namespace dls;

// =============================================================================
// Globals
// =============================================================================
// required to be global for visibility from signal handler
std::shared_ptr<App> pComponent;

// =============================================================================
// Classes
// =============================================================================
struct Args
{
    Args() : component_name(),
             lib_name(),
             component_type(),
             robot_name()
    {
    }

    std::string component_name;
    std::string lib_name;
    std::string component_type;
    std::string robot_name;
};

/// Parses the args and exits if the program if they are invalid
///
Args parse_args(int argc, char **argv);

/// Handles killing the component
///
void signal_handler(int signal);

logging::clogstream scout_sys("process_launcher");
logging::cerrstream scout_err("process_launcher");

void change_process_name(char **argv, const std::string &name)
{
	// change info in /proc/$pid/cmdline
	int alloted_space = std::strlen(argv[0]);
	std::strncpy(argv[0], name.c_str(), alloted_space);

	// change info in /proc/$pid/status
	prctl(PR_SET_NAME, name.c_str());
}

// =============================================================================
// Main
// =============================================================================
int main(int argc, char **argv)
{
    // give time to the logstrem connect to the logger layer
    // std::this_thread::sleep_for(std::chrono::milliseconds(500));
    // scout_sys << "PROCESS LAUNCHER CALLED" << std::endl;
    Args args = parse_args(argc, argv);

    // Load the component
    try
    {
        if (args.component_type == "layer")
        {
            scout_sys << "LOADING " << args.component_name << std::endl;
            pComponent =
                ClassLoader::loadClass<Layer, std::string, std::string>(
                    std::string("${DLS_INSTALL_LIB_DIR}/libdls_framework.so"),
                    args.component_name,
                    args.lib_name,
                    args.robot_name);
        }
        else if (args.component_type == "controller")
        {
            scout_sys << "LOADING CONTROLLER FROM '" << std::string("${DLS_INSTALL_CONTROLLER_DIR}/lib") + args.lib_name + ".so'" << std::endl;
            pComponent =
                ClassLoader::loadClass<Controller, std::string>(
                    std::string("${DLS_INSTALL_CONTROLLER_DIR}/lib") + args.lib_name + ".so",
                    args.robot_name);
        }
        else if (args.component_type == "motion_generator")
        {
            scout_sys << "LOADING MOTION GENERATOR FROM '" << std::string("${DLS_INSTALL_MOTION_GENERATOR_DIR}/lib") + args.lib_name + ".so'" << std::endl;
            pComponent =
                ClassLoader::loadClass<MotionGenerator, std::string>(
                    std::string("${DLS_INSTALL_MOTION_GENERATOR_DIR}/lib") + args.lib_name + ".so",
                    args.robot_name);
        }
        else if (args.component_type == "hardware")
        {
            scout_sys << "LOADING HARDWARE FROM '" << std::string("${DLS_INSTALL_HARDWARE_DIR}/lib") + args.lib_name + ".so'" << std::endl;
            pComponent =
                ClassLoader::loadClass<Hardware, std::string>(
                    std::string("${DLS_INSTALL_HARDWARE_DIR}/lib") + args.lib_name + ".so",
                    args.robot_name);
        }
        else if (args.component_type == "estimator")
        {
            scout_sys << "LOADING ESTIMATOR FROM '" << std::string("${DLS_INSTALL_ESTIMATOR_DIR}/lib") + args.lib_name + ".so'" << std::endl;
            pComponent =
                ClassLoader::loadClass<Estimator, std::string>(
                    std::string("${DLS_INSTALL_ESTIMATOR_DIR}/lib") + args.lib_name + ".so",
                    args.component_name);
        }
        else if (args.component_type == "service")
        {
            scout_sys << "LOADING SERVICE FROM '" << std::string("${DLS_INSTALL_SERVICE_DIR}/lib") + args.lib_name + ".so'" << std::endl;
            try
            {
                pComponent =
                    ClassLoader::loadClass<ServiceBase, std::string>(
                        std::string("${DLS_INSTALL_SERVICE_DIR}/lib") + args.lib_name + ".so",
                        args.component_name);
            }
            catch (const std::exception &e)
	        {
                pComponent =
                    ClassLoader::loadClass<ServiceBase, std::string>(
                        std::string("/usr/lib/dls2/lib") + args.lib_name + ".so",
                        args.component_name);
            }
        }
        else
        {
            scout_err << "component loading not yet implemented" << std::endl;
            exit(EXIT_FAILURE);
        }
    }
    catch (const std::exception &e)
    {
        // logging::cfatalstream s(process_handle);
        // s << "Component '" << args.component_name << "' of type '"
        // 	<< args.component_type << "' not found" << std::endl;
        scout_err << "Could not load component '" << args.component_name
                  << "' of type '" << args.component_type 
                  << ". Error msg: " << e.what() << std::endl;
        exit(EXIT_FAILURE);
    }

    // Register signal handler
    std::signal(SIGINT, signal_handler);

    change_process_name(argv, args.component_name.c_str());

    scout_sys << "Loaded component " << pComponent->getID() << std::endl;

    pComponent->run();

    return 0;
}

Args parse_args(int argc, char **argv)
{
    if (argc != 5)
    {
        scout_err << "Error: incorrect number of arguments" << std::endl;
        exit(EXIT_FAILURE);
    }
    // for (size_t i = 1; i <= 5; i++)
    // {
    //     std::cout << "arg " << i << ": " << argv[i] << std::endl;
    // }

    Args args;
    args.component_name = argv[1];
    args.lib_name = argv[2];
    args.component_type = argv[3];
    args.robot_name = argv[4];

    if (
        args.component_type != "layer" &&
        args.component_type != "controller" &&
        args.component_type != "motion_generator" &&
        args.component_type != "hardware" &&
        args.component_type != "estimator" &&
        args.component_type != "service"
        )
    {
        std::cerr << "Error: unknown component type '" << args.component_type << "'" << std::endl;
        exit(EXIT_FAILURE);
    }

    return args;
}

void signal_handler(int signal)
{
    if (signal == SIGINT)
    {
        pComponent->stop();

        // std::cout << pComponent->getID() << " received kill request" << std::endl;
        AppStatus exit_status = pComponent->getStatus();

        // give fastrtps a moment to send its message
        // std::this_thread::sleep_for(std::chrono::milliseconds(1000));
        exit(static_cast<int>(exit_status));
    }
}