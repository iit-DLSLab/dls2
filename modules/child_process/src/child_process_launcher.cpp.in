// =============================================================================
// Includes
// =============================================================================
// arguments to this program are:
//
// * component name                - name of the component to load
// * <controller | motion_generator> - the type of the component to load A
// * <hyq | hyqreal>               - the robot for which this component is loaded
#include <iostream>
#include <cstdlib>
#include <memory>
#include <string>
#include <csignal>
#include <sstream>
#include <unistd.h>
#include <sys/prctl.h>

#include "dls2/class_loader.hpp"
#include "dls2/plugin/periodic_app_plugin.hpp"
#include "dls2/plugin/app_plugin.hpp"
#include "dls2/hardware/hardware.hpp"
#include "dls2/estimator/estimator.hpp"
// #include "dls2/service/service_base.hpp"
#include "dls2/data_visualizer/data_visualizer_base.hpp"
#include "dls2/log/event_logger.hpp"
#include "dls2/application/layer.hpp"

#include "robotlib/robot_factory.hpp"

// =============================================================================
// Using Declarations
// =============================================================================
using namespace dls;
std::string process_name("");
CommandManager stopper("process_launcher");
void shutdown(int)
{
    bool stop_wait = false;
    if (process_name.compare("")==0)
        exit(EXIT_FAILURE);
    else if(stopper.waitCommand(process_name, "shutdown", stop_wait))
        stopper.callCommand("shutdown", {}, process_name);
    else{
        std::cerr << process_name <<"::shutdown not found. Process is brutally killed.";
        exit(EXIT_FAILURE);
    }
}

// =============================================================================
// Globals
// =============================================================================
// required to be global for visibility from signal handler
// std::shared_ptr<App> pComponent;

// =============================================================================
// Classes
// =============================================================================
struct Args
{
    Args() : component_name(),
             lib_name(),
             component_type(),
             robot_name()
    {
    }

    std::string component_name;
    std::string lib_name;
    std::string component_type;
    std::string robot_name;
};

/// Parses the args and exits if the program if they are invalid
///
Args parse_args(int argc, char **argv);

/// Handles killing the component
///
// void signal_handler(int signal);

logging::TerminalLogger terminal_logger("process_launcher");

void change_process_name(char **argv, const std::string &name)
{
	// change info in /proc/$pid/cmdline
	int alloted_space = std::strlen(argv[0]);
	std::strncpy(argv[0], name.c_str(), alloted_space);

	// change info in /proc/$pid/status
	prctl(PR_SET_NAME, name.c_str());
}

// =============================================================================
// Main
// =============================================================================
int main(int argc, char **argv)
{
    // When the user presses CTRL+C, make sure that all layers are shutdown
    signal(
        SIGINT,
        shutdown);
    // give time to the logstrem connect to the logger layer
    Args args = parse_args(argc, argv);

    std::shared_ptr<App> pComponent;

    // Load the component
    try
    {
        if (args.component_type == "layer")
        {
            pComponent =
                ClassLoader::loadClass<Layer, std::string, std::string>(
                    std::string("${DLS_INSTALL_LIB_DIR}/libdls_framework.so"),
                    args.component_name,
                    args.lib_name,
                    args.robot_name);
        }
        else if (args.component_type == "controller")
        {
            pComponent =
                    ClassLoader::loadClass<PeriodicAppPlugin, std::string>(
                        std::string("${DLS_INSTALL_CONTROLLER_DIR}/lib") + args.lib_name + ".so",
                        args.component_name,
                        args.robot_name);
        }
        else if (args.component_type == "motion_generator")
        {
            pComponent =
                    ClassLoader::loadClass<PeriodicAppPlugin, std::string>(
                        std::string("${DLS_INSTALL_MOTION_GENERATOR_DIR}/lib") + args.lib_name + ".so",
                        args.component_name,
                        args.robot_name);
        }
        else if (args.component_type == "hardware")
        {
            if (args.component_name.compare("gazebo_sim")==0){
                pComponent =
                    ClassLoader::loadClass<Hardware, std::string>(
                        std::string("${DLS_INSTALL_HARDWARE_DIR}/lib") + args.lib_name + ".so",
                        args.robot_name);
            }
            else{
                pComponent =
                        ClassLoader::loadClass<PeriodicAppPlugin, std::string>(
                            std::string("${DLS_INSTALL_HARDWARE_DIR}/lib") + args.lib_name + ".so",
                            args.component_name,
                            args.robot_name);
            }
        }
        else if (args.component_type == "estimator")
        {
            pComponent =
                ClassLoader::loadClass<PeriodicAppPlugin, std::string>(
                    std::string("${DLS_INSTALL_ESTIMATOR_DIR}/lib") + args.lib_name + ".so",
                    args.component_name,
                    args.robot_name);
        }
        else if (args.component_type == "periodic_app_plugin")
        {
            pComponent =
                ClassLoader::loadClass<PeriodicAppPlugin, std::string>(
                    std::string("${DLS_INSTALL_PERIODIC_APP_PLUGIN_DIR}/lib") + args.lib_name + ".so",
                    args.component_name,
                    args.robot_name);
        }
        else if (args.component_type == "python_periodic_app")
        {
            const std::string python_entrypoint = std::string("/usr/bin/") + args.lib_name;
            change_process_name(argv, args.component_name.c_str());
            execl(
                python_entrypoint.c_str(),
                args.component_name.c_str(),
                static_cast<char*>(nullptr));

            std::stringstream ss;
            ss << "could not exec python periodic app " << python_entrypoint;
            throw std::runtime_error(ss.str());
        }
        else if (args.component_type == "app_plugin")
        {
            pComponent =
                ClassLoader::loadClass<AppPlugin, std::string>(
                    std::string("${DLS_INSTALL_APP_PLUGIN_DIR}/lib") + args.lib_name + ".so",
                    args.component_name,
                    args.robot_name);
        }
        else if (args.component_type == "app_plugin")
        {
            pComponent =
                ClassLoader::loadClass<AppPlugin, std::string>(
                    std::string("${DLS_INSTALL_APP_PLUGIN_DIR}/lib") + args.lib_name + ".so",
                    args.component_name,
                    args.robot_name);
        }
        else
        {
            terminal_logger.error("component loading not yet implemented");
            usleep(1000000);
            exit(EXIT_FAILURE);
        }
    }
    catch (const std::exception &e)
    {
        // logging::cfatalstream s(process_handle);
        // s << "Component '" << args.component_name << "' of type '"
        // 	<< args.component_type << "' not found" << std::endl;
        terminal_logger.error("Could not load component '" + args.component_name
                  + "' of type '" + args.component_type
                  + ". Error msg: " + e.what());
            usleep(1000000);
        exit(EXIT_FAILURE);
    }

    process_name = pComponent->getID();

    change_process_name(argv, args.component_name.c_str());

    terminal_logger.info("Loaded component " + pComponent->getID());

    pComponent->execute();

    return 0;
}

Args parse_args(int argc, char **argv)
{
    if (argc != 5)
    {
        terminal_logger.error("Error: incorrect number of arguments");
        exit(EXIT_FAILURE);
    }
    // for (size_t i = 1; i <= 5; i++)
    // {
    //     std::cout << "arg " << i << ": " << argv[i] << std::endl;
    // }

    Args args;
    args.component_name = argv[1];
    args.lib_name = argv[2];
    args.component_type = argv[3];
    args.robot_name = argv[4];

    if (
        args.component_type != "layer" &&
        args.component_type != "controller" &&
        args.component_type != "motion_generator" &&
        args.component_type != "hardware" &&
        args.component_type != "estimator" &&
        args.component_type != "service"&&
        args.component_type != "periodic_app_plugin" &&
        args.component_type != "python_periodic_app" &&
        args.component_type != "app_plugin"
        )
    {
        std::cerr << "Error: unknown component type '" << args.component_type << "'" << std::endl;
        exit(EXIT_FAILURE);
    }

    return args;
}
