// =============================================================================
// Main Logic
// =============================================================================
int main(int argc, char **argv)
{
	change_process_name(argv, "dls_framework");

	#ifndef NDEBUG
		std::cout << "Debug build" << std::endl;
	#endif

	// Parse arguments and verify if they are valid and if there is anything to 
	// do or just print the usage
	if (!Options::parseArgs(argc, argv))
		return 0;

    // When the user presses CTRL-C, make sure that all child processes are
	// killed. If this is not done, the child processes will inherit from the
	// base process and continue to run even if the framework exits.
	// signal
	// (
	// 	SIGINT,
	// 	kill_children
	// );

	if(Options::show_docs)
	{
		return system
		(
			"@DLS_INSTALL_SCRIPTS_DIR@/xdg-open @DLS_INSTALL_DEVELOPMENT_DOCS_DIR@/html/index.html >nul 2>nul &"
		);
	}

	// Launch layers
	if(Options::launch_log) 		forkLayer<LogLayer>("logLayer", argv);
	if(Options::launch_hardware) 	forkLayer<HardwareLayer>("hardwareLayer", argv);
	if(Options::launch_control)  	forkLayer<ControlLayer>("controlLayer", argv);
	if(Options::launch_console)	 	forkLayer<ConsoleLayer>("consoleLayer", argv);
	if(Options::launch_estimation)	forkLayer<EstimationLayer>("estimationLayer", argv);
	if(Options::launch_service)	    forkLayer<ServiceLayer>("serviceLayer", argv);
	if(Options::launch_foxglove)	forkLayer<FoxgloveLayer>("foxgloveLayer", argv);

	//Time::set_use_simulated_time(Options::is_simulation());
	if(Options::robot_name != "")
	{
		CommandManager cmd_manager("main");
		std::this_thread::sleep_for(std::chrono::milliseconds(2000));
		cmd_manager.callCommand("loadService", {"dls_param_server"}, "serviceLayer");
		std::this_thread::sleep_for(std::chrono::milliseconds(1000));
		cmd_manager.callCommand("setParam", {"robot_name", Options::robot_name}, "dls_param_server");
	}

	// Initiate log streams
	// Does not initiate these before fork actions, dds will break
	logging::clogstream outstream("fwkMonitorStream");
	logging::cfatalstream sfatal("fwkMonitorFatal");

	// Monitor the child processes
	// loop is exited when there are no more children
	while(true)
	{		
		std::stringstream ss;
		int status;
		pid_t child_pid = wait(&status);
		
		if(child_pid == -1)
		{
			// if no more children left
			if(errno == ECHILD)
			{
				break;
			}
		}

		auto it = child_datas.find(child_pid);
		if(it != child_datas.end())
		{
			ss << it->second.name;
			// Ignoring WIFSTOPPED, WSTOPSIG, WIFCONTINUED
			if(WIFEXITED(status))
			{
				ss << " exited normally with exit status " << WEXITSTATUS(status);
			}
			if(WIFSIGNALED(status))
			{
				ss << " exited by signal " << WTERMSIG(status);

				#ifdef WCOREDUMP
				if(WCOREDUMP(status)) // not available on all unix implementations
				{
					ss << " and had a core dump";
				}
				#endif
			}
			ss.flush();
		}
		outstream << ss.str() << std::endl;	
	}
	
	std::cout << "=== FRAMEWORK NODE STOPPED ===" << std::endl;
	return 0;
}

// =============================================================================
// Helper Functions
// =============================================================================
void change_process_name(char **argv, const std::string &name)
{
	// change info in /proc/$pid/cmdline
	int alloted_space = std::strlen(argv[0]);
	std::strncpy(argv[0], name.c_str(), alloted_space);

	// change info in /proc/$pid/status
	prctl(PR_SET_NAME, name.c_str());
}

template <class layer_t>
void forkLayer(const std::string &process_name, char **argv)
{
	const pid_t pid = fork();
	if(pid == -1)
	{
		auto error = errno;
		std::cerr << "Could not fork" << std::endl;
		switch(error)
		{
			case EAGAIN:
				std::cout << "Thread limit reached or SCHED_DEADLINE used" << std::endl;
				break;
			case ENOMEM:
				std::cout << "Out of memory" << std::endl;
				break;
		}
	}
	else if(pid == 0)
	{
		change_process_name(argv, process_name);

		// // register shutdown handler
		// signal
		// (
		// 	SIGINT,
		// 	stop_app_handler
		// );
		// signal
		// (
		// 	SIGSEGV,
		// 	app_panic_handler
		// );
		
		layer_t pLayer(process_name);
		pLayer.run();
		exit(EXIT_SUCCESS);
	}
	else
	{
		child_datas.emplace
		(
			std::piecewise_construct,
			std::forward_as_tuple(pid),
			std::forward_as_tuple(process_name, pid)
		);
	}
}

