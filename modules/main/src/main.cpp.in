#include "dls2/main/run_dls2.hpp"

#include <cstdlib>
#include <exception>
#include <iostream>

int main(int argc, char **argv)
{
	try {
		dls::RunDLS2 run_dls2(argc, argv);
		run_dls2.run();
		return EXIT_SUCCESS;
	} catch (const std::exception& error) {
		std::cerr << "Framework failed: " << error.what() << std::endl;
	} catch (...) {
		std::cerr << "Framework failed: unknown exception" << std::endl;
	}
	return EXIT_FAILURE;
}
