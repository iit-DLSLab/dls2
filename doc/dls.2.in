.TH dls 1 "Build date: @DLS_COMPILE_DATE@" "version @PROJECT_VERSION@" "Dynamic Legged Systems Framework"

.\" ============================================================================
.SH NAME
.\" ============================================================================

dls - Dynamic Legged Systems software framework for the HyQ robot family.

.\" ============================================================================
.SH SYNOPSIS
.\" ============================================================================
.nf
.B find_package(dls CONFIG REQUIRED)
.BI dls_install_motion_generator( generator )
.BI dls_install_controller( controller )

.B #include <dls2/controller/controller.hpp>
.B dls::Controller
.B dls::ControlSignal
.BI DLS_EXPORT_CONTROLLER( controller )

.B #include <dls2/motion_generator/motion_generator.hpp>
.B dls::MotionGenerator
.B dls::GaitSignal
.BI DLS_EXPORT_MOTION_GENERATOR( generator )

.B #include <dls2/util/log/log.hpp>
.B dls::logging::cdbgstream
.B dls::logging::clogstream
.B dls::logging::clogstream
.B dls::logging::cerrstream
.B dls::logging::cfatalstream

.B #include <dls2/command/command.hpp>
.BI "template " " " "<typename " "ret_t, " "typename... " "arg_ts" ">"
.B void addCommand
.B (
.BI "	const" " " "std::string" " &owner,"
.BI "	const" " " "std::string" " &command_name,"
.BI "	const" " " "std::string" " &docstring,"
.BI "	const" " " "std::function<ret_t(arg_ts...)>" " &f"
.B );
.B dls::ARGVOID

.fi

.\" ============================================================================
.SH DESCRIPTION
.\" ============================================================================

Different components and plugins for the framework live and are managed by
different layers in the framework. For a description of these layers, see
dls(1). It is not necessary to understand the overall information flow of the
framework to write a plugin for it, as this is hiden by the API. However, a
high-level overview of the information flow in the framework is reported in the
following diagram:

.nf
@FLOW_CHART_INCL@
.fi

.SS Creating a New Motion Generator
.\" ----------------------------------------------------------------------------

@MOTION_GENERATOR_MD_MAN@


.SS Creating a New Controller
.\" ----------------------------------------------------------------------------

@CONTROLLER_MD_MAN@


.SS Exposing Commands to the framework
.\" ----------------------------------------------------------------------------

@COMMAND_MD_MAN@

.SS Logging
.\" ----------------------------------------------------------------------------

@LOGGING_MD_MAN@

.SS Publishers and Subscribers
.\" ----------------------------------------------------------------------------

@PUB_SUB_MD_MAN@

.SS Services
.\" ----------------------------------------------------------------------------

@SERVICE_MD_MAN@

.\" ----------------------------------------------------------------------------

.\" ============================================================================
.SH SEE ALSO
.\" ============================================================================
dls(1)
grep(1)
awk(1)
