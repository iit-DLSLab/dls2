.TH dls 1 "Build date: @DLS_COMPILE_DATE@" "version @PROJECT_VERSION@" "Dynamic Legged Systems Framework"

.\" ============================================================================
.SH NAME
.\" ============================================================================

dls - Dynamic Legged Systems software framework for the HyQ robot family.

.\" ============================================================================
.SH SYNOPSIS
.\" ============================================================================
.nf
.B find_package(dls CONFIG REQUIRED)
.BI dls_install_gait_generator( generator )
.BI dls_install_controller( controller )

.B #include <dls2/controller/controller.hpp>
.B #include <dls2/gait_generator/gait_generator.hpp>

.BI DLS_EXPORT_CONTROLLER( controller )
.BI DLS_EXPORT_GAIT_GENERATOR( generator )
.fi

.\" ============================================================================
.SH DESCRIPTION
.\" ============================================================================

Different components and plugins for the framework live and are managed by
different layers in the framework. For a description of these layers, see
dls(1). It is not necessary to understand the overall information flow of the
framework to write a plugin for it, as this is hiden by the API. However, a
high-level overview of the information flow in the framework is reported in the
following diagram:

.\" +------------+
.\" | Low Level  |
.\" | Estimator  |
.\" +------------+
.\" +------------+
.\" | High Level |
.\" | Estimator  |
.\" +------------+
.\" +------------+
.\" | Gait       |
.\" | Generator  |
.\" +------------+
.\" +------------+
.\" | Controller |
.\" | 1          |
.\" +------------+

.nf
       +------------+        +------------+
       | Reference  |        | Hardware/  |
+------+ Input      |        | Simulation |
|      +------------+        +-----^+-----+
|                                  ||
|                          Torques || Raw Sensor Readings
|  Hardware Layer                  ||
|  +-------------------------------+v---------------------------------+
|  | +------------+   +------------+                   +------------+ |
|  | | Low Level  |   | Low Level  |                   | Low Level  | |
|  | | Estimator 1|   | Estimator 2|  ................ | Estimator n| <--+
|  | +------------+   +------------+                   +------------+ |  |
|  +-------------------------------+----------------------------------+  |
|                                  |                                     |
|                                  | Sensor State                        |
|  Estimation Layer                |                                     |
|  +-------------------------------v----------------------------------+  |
|  | +------------+   +------------+                   +------------+ |  |
|  | | High Level |   | High Level |                   | High Level | |  |
|  | | Estimator 1|   | Estimator 2|  ................ | Estimator n| |  |
|  | +------------+   +------------+                   +------------+ |  |
|  +-------------------------------+----------------------------------+  |
|                                  |                                     |
|                                  | Robot State                         |
|  Control Layer                   |                                     |
|  +-------------------------------v----------------------------------+  |
|  | +------------+                                                   |  |
+--|-> Gait       |                                                   |  |
   | | Generator  |                                                   |  |
   | +-----+------+                                                   |  |
   |       |                  Gait Signal                             |  |
   |       +----------------+--------------------------------+        |  |
   |       |                |                                |        |  |
   | +-----v------+   +-----v------+                   +-----v------+ |  |
   | |            |   |            |                   |            | |  |
   | |Controller 1|   |Controller 2|  ................ |Controller n| |  |
   | +-----+------+   +-----+------+                   +-----+------+ |  |
   |       |                |         Desired Torque         |        |  |
   |       +----------------+------+-------------------------+        |  |
   |                               |                                  |  |
   |                         +-----v------+                           |  |
   |                         |            |                           |  |
   |                         | Sum        |                           |  |
   |                         +-----+------+                           |  |
   |                               |                                  |  |
   |                         +-----v------+                           |  |
   |                         |            |                           |  |
   |                         | Saturation |                           |  |
   |                         +-----+------+                           |  |
   |                               |                                  |  |
   +-------------------------------+----------------------------------+  |
                                   |                                     |
                                   |           Desired Torques           |
                                   +-------------------------------------+
.fi




.SS Creating a New Gait Generator
.\" ----------------------------------------------------------------------------

A gait generator is created by inheriting from the gait generator base class.
Consider the example header file:

.RS
.nf
#include <dls2/gait_generator/gait_generator.hpp>

class ExampleGaitGenerator : public dls::GaitGenerator
{
public:
	ExampleGaitGenerator(std::shared_ptr<dls::dog::Dog>);
	~ExampleGaitGenerator();

	// Called at the rate specified in the constructor
	void run(const std::chrono::system_clock::time_point&) override;

	// Implement any emergency stop procedures here
	Status eStop() override;

private:
	dls::GaitSignal data;
};
.fi
.RE

and its corresponding source file

.RS
.nf
ExampleGaitGenerator::ExampleGaitGenerator
(
	std::shared_ptr<dls::dog::Dog> pDog
) :
	GaitGenerator
	(
		pDog,
		"example_gait_generator",     // ID of this gait generator
		std::chrono::milliseconds(4)  // period of this gait generator
	)
{
	// Constructor runs as non-realtime code
}


void ExampleGaitGenerator::run(const std::chrono::system_clock::time_point&)
{
	// realtime code. Perform calculations here
	// write data to GaitSignal

	// publish
	publishData(data);
}
// Export the gait generator so that it may be loaded by the framework
.BI DLS_EXPORT_GAIT_GENERATOR( ${generator} )
.fi
.RE


.SS Creating a New Controller
.\" ----------------------------------------------------------------------------

A controller may be created by inheriting from the controller base class.
Consider the header file:

.RS
.nf
#include <dls2/controller/controller.hpp>

class ExampleController : public dls::Controller
{
public:
	ExampleController(std::shared_ptr<dls::dog::Dog>);

	// Called at the rate specified in the constructor
	void run(const std::chrono::system_clock::time_point&) override;

	// Implement any emergency stop procedures here
	Status eStop() override;
private:
	dls::ControlSignal s;
};
.fi
.RE

and its corresponding source file:

.RS
.nf
ExampleController::ExampleController
(
	std::shared_ptr<dls::dog::Dog> pDog
) :
	dls::Controller
	(
		pDog,
		"controller_name",              // ID of this controller
		std::chrono::milliseconds(4),   // period of this controller
		dls::ControlSignal::SignalReconstructionMethod::ZERO_ORDER_HOLD
	)
{
	// The constructor is not realtime. Assign memory here
	this->s.torques.resize(pDog->nDof());
}

void ExampleController::run(const std::chrono:system_clock::time_point&)
{
	auto pSignal = this->readGaitSignal();
	if(pSignal)
	{
		// calculations when a gait signal is received
	}
	else
	{
		// what to do when no signal is received
	}

	// set torques
	s.torques << 1, 2, 3; // ...

	// publish torques to framework
	publishSignal(s);
}

// Export the controller so that it may be loaded into the framework
DLS_EXPORT_CONTROLLER(ExampleController)
.fi
.RE

.SS Installing
.\" ----------------------------------------------------------------------------

The framework will look for controllers and generators in predefined
installation directories.


To install them to the correct directories, use the following CMake macros:

.nf
find_package(dls CONFIG REQUIRED)
dls_install_gait_generator( ${generator_name} )
dls_install_controller( ${controller_name} )
.fi

