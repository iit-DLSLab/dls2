#include <dls/util/log/log.hpp>

int main()
{
	// Define a log stream, in this case a debug log stream, and tell it the
	// name of the component that is publishing the logs
	dls::logging::cdbgstream debug_stream("my_component_name");

	// Log some complicated data
	debug_stream << "Value: " << my_struct.position.transpose() << std::endl;
}
