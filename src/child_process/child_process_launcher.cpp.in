// This program cannot be run from the command line, as it intentionally does
// not follow the unix command line convention of having the first argument be
// the name of the program.
//
// Instead, this program can be launched from the control layer or the
// estimation layer to put a component in a separate process. This is
// beneficial, since many of these components are experimental, non-robust code
// that may crash at any time. Having them in separate processess means that the
// framework can recover elegantly from such crashes.
//
// The arguments passed to this program from elsewhere in the framework are, in
// order:
//
// * <component-name>                        -- the name of the library, not
//                                              including leading "lib" or
//                                              trailing ".so"
//                                              (needs to be first so that the
//                                              name of this component is shown
//                                              in tools such as htop)
// * controller | gait_generator | estimator -- the component type to launch
// * hyq | hyqreal                           -- the robot to launch on
// * simulated | hardware                    -- whether simulation or hardware
//
// The lifetime of this program is managed by the component in the framework
// that launched it. That component is responsible for monitoring any crashes in
// the libraries that are loaded here. The calling component is also responsible
// for requesting that this component cease execution. This is achieved by
// sending SIGTERM, which is caught and handled by this program to properly stop
// the libraries loaded here.
//
// Should the expermental libraries loaded herein be unable to close properly,
// it is possible to force kill this program and all of its decendants using
// tools such as htop and sending SIGKILL to the entire descendant tree.
// =============================================================================
// Includes
// =============================================================================
// =================================== stdlb ===================================
#include <iostream>
#include <cstdlib>
#include <memory>
#include <string>
#include <csignal>
#include <sstream>
#include <cstring>

// =================================== libs ====================================
// TODO remove this include
// This is put here because the controllers in the old framework are entwined
// with ros to an egregious extent. When they have been disentangled, this, as
// well as the call to ros::init, may be removed
#include <ros/ros.h>

// ================================== project ==================================
#include "dls2/util/class_loader.phpp"
#include "dls2/controller/controller.hpp"
#include "dls2/gait_generator/gait_generator.hpp"
#include "dls2/estimator/estimator.hpp"
#include "dls2/util/log/log.hpp"

// ==================================== tmp ====================================
#include "dls2/util/time/time.hpp"
#include <doglib/factory/robot_factory.hpp>

// =============================================================================
// Using Declarations
// =============================================================================
using namespace dls;

// =============================================================================
// Prototypes
// =============================================================================
/// Checks whether the arguments given to the program are valid. Exits the
/// program early if they are invalid
///
/// The valid arguments are described in the top of the source file containing
/// this function
void assert_valid_args(int argc, char **argv);

/// Launches the requested component
///
/// @ret a shared pointer to the component
std::shared_ptr<PeriodicAppLayerComponent> load_component
(
	int argc,
	char **argv
);

/// Properly stops the loaded library on SIGTERM and exits this program with the
/// exit code of that library
void signal_handler(int signal);

// =============================================================================
// Globals
// =============================================================================
/// The name of the launcher as reported in the logs of the framework
///
auto process_handle = "controller_child_process_launcher";

/// The component to be launched by this program
///
/// This is made global so that the signal handler can see it. Refactor this if
/// scope creep occurs
std::shared_ptr<PeriodicAppLayerComponent> pComponent;

/// Prints the error message and exits the program
///
void error();

// =============================================================================
// Main
// =============================================================================
// note that the arguments are currently handled in a kind of dirty, brittle
// way. If scope creep occurs, refactor the argument handling into something
// more robust, also from the side of the rest of the framework that needs to
// call this program. The firs thing that would need to be improved would be to
// remove the magic numbers into the argv array
int main(int argc, char **argv)
{
	#ifndef NDEBUG
		std::cout << "Process launcher debug build"  << std::endl;
	#endif
	assert_valid_args(argc, argv);

	// The controllers are currently dependant on ros, so launch it here
	ros::init(argc, argv, argv[0]);

	// If simulation mode specified, use simulated sleep
	Time::set_use_simulated_time
	(
		std::strcmp(argv[3], "simulated") == 0
	);

	// load the library
	pComponent = load_component(argc, argv);

	// regiser stopping interface
	std::signal(SIGTERM, signal_handler);

	// run the library until stop request
	pComponent->run();

	return EXIT_SUCCESS;
}

// =============================================================================
// Local Functions
// =============================================================================
void assert_valid_args(int argc, char **argv)
{
	for(int i = 0; i != 4; ++i)
	{
		std::cout << argv[i] << std::endl;
	}
	std::cout <<  "===" << std::endl;
	if(argc != 4)
	{
		std::cerr << "arg number" << std::endl;
		error();
	}

	std::string component_type(argv[1]);
	if
	(
		component_type != "controller"
		&& component_type != "gait_generator"
		// note also the estimator launch code is commented out below
		// && component_type != "estimator"
	)
	{
		std::cerr << "got component name: " << argv[1] << std::endl;
		error();
	}

	std::string robot_name(argv[2]);
	if
	(
		robot_name != "hyq"
		&& robot_name != "hyqreal"
	)
	{
		std::cerr << "got robot name: " << argv[2] << std::endl;
		error();
	}

	std::string mode(argv[3]);
	if
	(
		mode != "simulated"
		&& mode != "hardware"
	)
	{
		std::cerr << "got mode " << argv[3] << std::endl;
		error();
	}

	// if we get here the arguments are valid, just return
}

void error()
{
	std::cerr <<
		"Error. Call convention not honoured.\n"
		"Note that this program must not be manually called by the user. It is "
		"called by the framework"
	<< std::endl;

	logging::coutstream s(process_handle);
	s <<
		"Error. Call convention not honoured.\n"
		"Note that this program must not be manually called by the user. It is "
		"called by the framework"
	<< std::endl;
	exit(EXIT_FAILURE);
}

std::shared_ptr<PeriodicAppLayerComponent> load_component
(
	int /*argc*/,
	char **argv
)
{
	// Build robot
	std::shared_ptr<dog::Dog> pRobot;
	if(strcmp(argv[2], "hyq") == 0)
	{
		pRobot = dog::RobotFactory::buildRobot
		(
			dog::RobotFactory::RobotType::HyQ
		);
	}
	else
	{
		pRobot = dog::RobotFactory::buildRobot
		(
			dog::RobotFactory::RobotType::HyQReal
		);
	}

	logging::coutstream s(process_handle);

	std::shared_ptr<PeriodicAppLayerComponent> component;
	try // load library -- first try from the local directory
	{
		if(std::strcmp(argv[1], "controller") == 0)
		{
			component = ClassLoader::loadClass<Controller, std::shared_ptr<dog::Dog>>
			(
				std::string("./lib") + argv[0] + ".so",
				pRobot
			);
		}
		else if(std::strcmp(argv[1], "gait_generator") == 0)
		{
			component = ClassLoader::loadClass<GaitGenerator, std::shared_ptr<dog::Dog>>
			(
				std::string("./lib") + argv[0] + ".so",
				pRobot
			);
		}
		// else//(std::strcmp(argv[1], "estimator") == 0)
		// {
		// 	component = ClassLoader::loadClass<Estimator, std::shared_ptr<dog::Dog>>
		// 	(
		// 		std::string("./lib") + argv[0] + ".so",
		// 		pRobot
		// 	);
		// }
		s << "WARNING: loaded component from a local directory" << std::endl;
	}
	catch(const std::exception&) // next, try from the installed directories
	{
		try
		{
			if(std::strcmp(argv[1], "controller") == 0)
			{
				component = ClassLoader::loadClass<Controller, std::shared_ptr<dog::Dog>>
				(
					std::string("${DLS_INSTALL_CONTROLLER_DIR}/lib") + argv[0] + ".so",
					pRobot
				);
			}
			else if(std::strcmp(argv[1], "gait_generator") == 0)
			{
				component = ClassLoader::loadClass<GaitGenerator, std::shared_ptr<dog::Dog>>
				(
					std::string("${DLS_INSTALL_GAIT_GENERATOR_DIR}/lib") + argv[0] + ".so",
					pRobot
				);
			}
			// else//(std::strcmp(argv[1], "estimator") == 0)
			// {
			// 	component = ClassLoader::loadClass<Estimator, std::shared_ptr<dog::Dog>>
			// 	(
			// 		std::string("${DLS_INSTALL_ESTIMATOR_DIR}/lib") + argv[0] + ".so",
			// 		pRobot
			// 	);
			// }
		}
		catch(const std::exception&)
		{
			s << argv[0] << " of type " << argv[1] << " not found" << std::endl;
			std::cerr << argv[0] << " of type " << argv[1] << " not found" << std::endl;
			exit(EXIT_FAILURE);
		}
	}

	return component;
}

void signal_handler(int signal)
{
	if(signal == SIGTERM)
	{
		// ask the component to stop nicely
		pComponent->stop();

		// inform the user
		logging::coutstream s(process_handle);
		s << pComponent->getID() << " received kill request" << std::endl;

		auto exit_status = pComponent->getStatus();

		// make sure the destructor is run properly and give fastrtps a moment
		// to send its messages
		pComponent = nullptr;
		std::this_thread::sleep_for(std::chrono::milliseconds(300));

		// exit the program with the exit status of the component
		exit(static_cast<int>(exit_status));
	}
}
