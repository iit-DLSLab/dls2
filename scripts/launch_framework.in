#!/bin/bash

source @DLS_CATKIN_WORKSPACE_DIR@/install/setup.bash 2>/dev/null
if [ ! $? -eq 0 ]; then
	echo "Error: dls2 catkin workspace not found. Be sure to install it first"
	exit -1
fi

export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib:/usr/lib/dls2

LD_LIBRARY_PATH=@DLS_INSTALL_GAIT_GENERATOR_DIR@:$LD_LIBRARY_PATH
LD_LIBRARY_PATH=@DLS_INSTALL_CONTROLLER_DIR@:$LD_LIBRARY_PATH
LD_LIBRARY_PATH=@DLS_INSTALL_ESTIMATOR_DIR@:$LD_LIBRARY_PATH
LD_LIBRARY_PATH=@DLS_INSTALL_MESSAGES_DIR@:$LD_LIBRARY_PATH

@DLS_INSTALL_RUNTIME_DIR@/dynamic_legged_systems_framework "$@"
