set(DLS_MESSAGE_HEADER_DESTINATION dls2/msg/${PROJECT_NAME})
@DLS_MESSAGE_CMAKE@
list(APPEND CMAKE_LIBRARY_PATH @DLS_INSTALL_MESSAGES_DIR@)

# ==============================================================================
# Functions to install plugins to correct directories automatically
# ==============================================================================
function(dls_enforce_shared_lib target)
	get_target_property(target_type ${target} TYPE)
	if(NOT target_type STREQUAL "SHARED_LIBRARY")
		message(FATAL_ERROR "Error, target ${target} must be a shared library")
	endif()
endfunction()

function(dls_install_plugin plugin)

	# Parse input
	include(CMakeParseArguments)
	set(prefix       ARG)
	set(noValues     "")
	set(singleValues TYPE DISPLAY_NAME)
	set(multiValues  HEADERS)
	cmake_parse_arguments(
		${prefix}
		"${noValues}"
		"${singleValues}"
		"${multiValues}"
		${ARGN}
	)

	# Install locations for each plugin type
	set(known_types                   gaitgen controller estimator)
	set(controller_install_dir        @DLS_INSTALL_CONTROLLER_DIR@)
	set(estimator_install_dir         @DLS_INSTALL_ESTIMATOR_DIR@)
	set(gaitgen_install_dir           @DLS_INSTALL_GAIT_GENERATOR_DIR@)
	set(controller_install_header_dir @DLS_INSTALL_CONTROLLER_HEADER_DIR@)
	set(estimator_install_header_dir  @DLS_INSTALL_ESTIMATOR_HEADER_DIR@)
	set(gaitgen_install_header_dir    @DLS_INSTALL_GAIT_GENERATOR_HEADER_DIR@)

	# Input sanitation
	if(NOT ${prefix}_TYPE)
		message(FATAL_ERROR "Error: TYPE was not specified")
	endif()
	list(FIND known_types ${${prefix}_TYPE} type_index)
	if(${type_index} EQUAL -1)
		message(FATAL_ERROR "Error: TYPE must be one of '${known_types}'")
	endif()
	if(NOT ${prefix}_DISPLAY_NAME)
		set(${prefix}_DISPLAY_NAME ${plugin})
	endif()

	# ==========================================================================
	# Install the plugin
	# ==========================================================================
	dls_enforce_shared_lib(${plugin})
	set(component_name "dls-plugin-${plugin}")
	install(
		TARGETS             ${plugin}
		LIBRARY DESTINATION ${${${prefix}_TYPE}_install_dir}
		COMPONENT           ${component_name}
	)

	# Register the type of the plugin
	set_property(
		TARGET   ${plugin}
		PROPERTY "DLS_TARGET_TYPE" ${${prefix}_TYPE}
	)

	# Register under which component this plugin is installed
	set_property(
		TARGET   ${plugin}
		PROPERTY "DLS_TARGET_COMPONENT_NAME" ${component_name}
	)

	# Register the display name to use when packaging this plugin
	set_property(
		TARGET   ${plugin}
		PROPERTY "DLS_TARGET_DISPLAY_NAME" ${${prefix}_DISPLAY_NAME}
	)

	# ==========================================================================
	# Install the plugin headers if specified
	# ==========================================================================
	# If there are headers to be installed
	list(LENGTH ${prefix}_HEADERS NUMBER_OF_INSTALL_HEADERS)
	if(${NUMBER_OF_INSTALL_HEADERS} GREATER 0)
		# Select the install location based on the type
		if(${${prefix}_TYPE} STREQUAL "gaitgen")
			set(HEADER_INSTALL_LOCATION "${gaitgen_install_header_dir}/${${prefix}_DISPLAY_NAME}")
		elseif(${${prefix}_TYPE} STREQUAL "controller")
			set(HEADER_INSTALL_LOCATION "${controller_install_header_dir}/${${prefix}_DISPLAY_NAME}")
		elseif(${${prefix}_TYPE} STREQUAL "estimator")
			set(HEADER_INSTALL_LOCATION "${estimator_install_header_dir}/${${prefix}_DISPLAY_NAME}")
		endif()

		# Install to the correct location
		install(
			FILES       ${${prefix}_HEADERS}
			COMPONENT   ${component_name}-dev
			DESTINATION ${HEADER_INSTALL_LOCATION}
		)

		# Register that this plugin needs to install header files too
		set_property(
			TARGET   ${plugin}
			PROPERTY "DLS_PLUGIN_HEADERS" ${${prefix}_HEADERS}
		)

	endif()
	# ==========================================================================
	# Keep track of all the plugins that are installed by this project
	# ==========================================================================
	get_property(
		list_of_plugins
		GLOBAL
		PROPERTY "DLS_LIST_OF_PLUGINS"
	)
	list(APPEND list_of_plugins ${plugin})
	set_property(
		GLOBAL
		PROPERTY "DLS_LIST_OF_PLUGINS" ${list_of_plugins}
	)
endfunction()

macro(dls_deploy_package)

	# Parse arguments
	include(CMakeParseArguments)
	set(prefix       ARG)
	set(noValues     "")
	set(singleValues MAINTAINER MAINTAINER_CONTACT VENDOR)
	set(multiValues  "")
	cmake_parse_arguments(
		${prefix}
		"${noValues}"
		"${singleValues}"
		"${multiValues}"
		${ARGN}
	)

	# Sanitise input
	if(NOT ${prefix}_MAINTAINER)
		message(FATAL_ERROR "Error: 'MAINTAINER' not specified")
	endif()
	if(NOT ${prefix}_MAINTAINER_CONTACT)
		message(FATAL_ERROR "Error: 'MAINTAINER_CONTACT' not specified")
	endif()
	if(NOT ${prefix}_VENDOR)
		set(${prefix}_VENDOR "dlslab")
	endif()

	# set CPack variables
	set(CPACK_PACKAGE_NAME              ${PROJECT_NAME})
	set(CPACK_PACKAGE_VERSION_MAJOR     ${PROJECT_VERSION_MAJOR})
	set(CPACK_PACKAGE_VERSION_MINOR     ${PROJECT_VERSION_MINOR})
	set(CPACK_PACKAGE_VERSION_PATCH     ${PROJECT_VERSION_PATCH})
	set(CPACK_DEBIAN_PACKAGE_VERSION    ${PROJECT_VERSION})
	set(CPACK_PACKAGE_VENDOR            ${${prefix}_VENDOR})
	set(CPACK_PACKAGE_CONTACT           ${${prefix}_MAINTAINER_CONTACT})
	set(CPACK_VERBATIM_VARIABLES        ON)
	set(CPACK_GENERATOR                 "DEB")
	set(CPACK_DEBIAN_PACKAGE_MAINTAINER ${${prefix}_MAINTAINER})
	set(CPACK_DEB_COMPONENT_INSTALL     ON)

	# generate the file name and package name for everything developed in this project
	get_property(
		list_of_plugins
		GLOBAL
		PROPERTY "DLS_LIST_OF_PLUGINS"
	)
	
	foreach(plugin IN LISTS list_of_plugins)
		get_property(dls_target_type
			TARGET   ${plugin}
			PROPERTY "DLS_TARGET_TYPE"
		)
		get_property(plugin_component_name
			TARGET   ${plugin}
			PROPERTY "DLS_TARGET_COMPONENT_NAME"
		)

		get_property(plugin_display_name
			TARGET   ${plugin}
			PROPERTY "DLS_TARGET_DISPLAY_NAME"
		)

		string(TOUPPER ${plugin_component_name} plugin_component_name_upper)

		set(
			CPACK_DEBIAN_${plugin_component_name_upper}_PACKAGE_NAME
			"dls2-${dls_target_type}-${plugin_display_name}"
		)
		set(
			CPACK_DEBIAN_${plugin_component_name_upper}_FILE_NAME
			"dls2-${dls_target_type}-${plugin_display_name}-${PROJECT_VERSION}.deb"
		)

		# If the plugin installs header files
		get_property(plugin_install_headers
			TARGET ${plugin}
			PROPERTY "DLS_PLUGIN_HEADERS"
		)
		list(LENGTH plugin_install_headers NUMBER_OF_INSTALL_HEADERS)
		if(${NUMBER_OF_INSTALL_HEADERS} GREATER 0)
			set(
				CPACK_DEBIAN_${plugin_component_name_upper}-DEV_PACKAGE_NAME
				"dls2-${dls_target_type}-${plugin_display_name}-dev"
			)
			set(
				CPACK_DEBIAN_${plugin_component_name_upper}-DEV_FILE_NAME
				"dls2-${dls_target_type}-${plugin_display_name}-dev-${PROJECT_VERSION}.deb"
			)
		endif()
	endforeach()

	# set settings for the messaging library if messages were generated by this
	# package using `dls_add_message`
	if(TARGET dls_messaging)
		string(TOUPPER dls_messaging COMPONENT_NAME_UPPER)
		set(
			CPACK_DEBIAN_${COMPONENT_NAME_UPPER}_PACKAGE_NAME
			"dls2-messaging-${PROJECT_NAME}"
		)
		set(
			CPACK_DEBIAN_${COMPONENT_NAME_UPPER}_FILE_NAME
			"dls2-messaging-${PROJECT_VERSION}.deb"
		)
	endif()

	get_cmake_property(CPACK_COMPONENTS_ALL COMPONENTS)
	list(REMOVE_ITEM CPACK_COMPONENTS_ALL "Unspecified")
	include(CPack)
endmacro()
