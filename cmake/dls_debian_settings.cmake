    set(CPACK_DEBIAN_DLS_RUNTIME_FILE_NAME "dls2-runtime-${PROJECT_VERSION}.deb")
    set(CPACK_DEBIAN_DLS_RUNTIME_PACKAGE_NAME "dls2-runtime")
    set(CPACK_DEBIAN_DLS_RUNTIME_PACKAGE_DEPENDS "dls2-messaging")
