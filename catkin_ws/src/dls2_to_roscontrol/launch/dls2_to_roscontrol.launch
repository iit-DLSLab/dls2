<?xml version="1.0" ?>
<launch>
	<arg name="robot_name" default="hyq" />

	<rosparam file="$(find dls2_to_roscontrol)/config/$(arg robot_name)_control_params.yaml" command="load"/>
	<!-- rosparam file="$(find dls2_to_roscontrol)/config/joint_state_publisher.yaml" ns="/$(arg robot_name)" command="load"/ -->
	<!-- rosparam file="$(find wb_state_publisher)/config/wb_state_publisher.yaml" ns="/$(arg robot_name)" command="load"/ -->
	
	<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="/$(arg robot_name)" args="dls2_to_roscontrol"/> <!-- joint_state_publisher -->
			
</launch>
