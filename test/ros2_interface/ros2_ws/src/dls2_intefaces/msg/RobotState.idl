#include "Test.idl"
#include "DLSAnnotation.idl"

module dls2_interfaces {
  module msg {
       struct RobotState
       {
              // Header
              string frame_id;
              unsigned long sequence_id;
              double timestamp;
       
              double position[3];
              double orientation[4];

              sequence<double> joint_pos;

              dls2_interfaces::msg::Test test;

	            @JointState sequence<double> joints_temperature;
       };
  };
};