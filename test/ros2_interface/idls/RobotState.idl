#ifndef ROS2_INTERFACE_DLS2_INTERFACES_MSG_ROBOT_STATE_IDL_
#define ROS2_INTERFACE_DLS2_INTERFACES_MSG_ROBOT_STATE_IDL_

#include "Test.idl"

module dls2_interfaces {
  module msg {
       struct RobotState
       {
              // Header
              string frame_id;
              unsigned long sequence_id;
              double timestamp;
       
              double position[3];
              double orientation[4];

              sequence<double> joint_pos;

              dls2_interfaces::msg::Test test;

	             sequence<double> joints_temperature;
       };
  };
};

#endif // ROS2_INTERFACE_DLS2_INTERFACES_MSG_ROBOT_STATE_IDL_
