#!/usr/bin/env python3

from __future__ import annotations

import argparse
import os
import sys
import time
import types
from dataclasses import dataclass, field
from pathlib import Path


PLUGIN_PYTHON_DIR = Path("@PROJECT_SOURCE_DIR@/modules/plugin/python")
MESSAGE_DIR = Path("@PROJECT_BINARY_DIR@/modules/messages/include/dls_messages/dds")
DEFAULT_DOMAIN = 3


@dataclass(frozen=True)
class MessageSpec:
    topic: str
    module_relpath: str
    type_name: str
    wrapper_module: str
    identifier: str


@dataclass
class ReaderSlot:
    topic: str
    data_type: object
    type_support: object
    topic_handle: object
    listener: object
    reader: object


@dataclass
class SharedReaderParticipant:
    domain: int
    participant: object = field(init=False)
    subscriber: object = field(init=False)
    slots: list[ReaderSlot] = field(default_factory=list, init=False)

    def __post_init__(self) -> None:
        import fastdds
        from dls2_py.reader import _resolve_profile_path

        factory = fastdds.DomainParticipantFactory.get_instance()
        participant_qos = fastdds.DomainParticipantQos()
        factory.get_default_participant_qos(participant_qos)

        profile_path = _resolve_profile_path()
        if not os.path.exists(profile_path):
            raise FileNotFoundError(
                f"Missing DDS participant profile at {profile_path}. "
                "Install dls2_py runtime config or set DLS_DDS_PARTICIPANT_CONFIG."
            )

        factory.load_XML_profiles_file(profile_path)
        profile_name = "disc_server_client_domain_" + str(self.domain)
        self.participant = factory.create_participant_with_profile(profile_name)
        if self.participant is None:
            raise RuntimeError(
                f"Failed to create Fast DDS participant using profile '{profile_name}' "
                f"from {profile_path}."
            )

        subscriber_qos = fastdds.SubscriberQos()
        self.participant.get_default_subscriber_qos(subscriber_qos)
        self.subscriber = self.participant.create_subscriber(subscriber_qos)
        if self.subscriber is None:
            raise RuntimeError("Failed to create Fast DDS subscriber.")

    def add_reader(self, spec: MessageSpec) -> ReaderSlot:
        import fastdds
        from dls2_py.reader import ReaderListener

        module = _load_message_module(spec)
        data_type = getattr(module, f"{spec.type_name}PubSubType")()
        data = getattr(module, spec.type_name)()
        topic_name = f"rt/{spec.topic}"

        data_type.set_name(data_type.get_name())
        type_support = fastdds.TypeSupport(data_type)
        self.participant.register_type(type_support)

        topic_qos = fastdds.TopicQos()
        self.participant.get_default_topic_qos(topic_qos)
        topic_handle = self.participant.create_topic(topic_name, data_type.get_name(), topic_qos)
        if topic_handle is None:
            raise RuntimeError(f"Failed to create topic {topic_name}.")

        listener = ReaderListener(data)
        reader_qos = fastdds.DataReaderQos()
        self.subscriber.get_default_datareader_qos(reader_qos)
        reader = self.subscriber.create_datareader(topic_handle, reader_qos, listener)
        if reader is None:
            raise RuntimeError(f"Failed to create reader for {topic_name}.")

        slot = ReaderSlot(topic_name, data_type, type_support, topic_handle, listener, reader)
        self.slots.append(slot)
        return slot

    def close(self) -> None:
        import fastdds

        factory = fastdds.DomainParticipantFactory.get_instance()
        if getattr(self, "participant", None) is not None:
            self.participant.delete_contained_entities()
            factory.delete_participant(self.participant)
            self.participant = None


MESSAGE_SPECS = (
@cpp_python_communication_python_reader_specs@)


def _prepend_sys_path(path: Path) -> None:
    path = path.resolve()
    path_str = str(path)
    if path_str not in sys.path:
        sys.path.insert(0, path_str)


def _load_message_module(spec: MessageSpec) -> types.ModuleType:
    module_path = MESSAGE_DIR / spec.module_relpath
    if not module_path.exists():
        raise FileNotFoundError(f"Missing generated Python message module: {module_path}")

    _prepend_sys_path(module_path.parent)

    short_wrapper = f"_{spec.type_name}Wrapper"
    source = module_path.read_text()
    if spec.wrapper_module != short_wrapper:
        source = source.replace(
            f"from . import {short_wrapper}",
            f"from . import {spec.wrapper_module} as {spec.wrapper_module}",
        )
        source = source.replace(
            f"import {short_wrapper}",
            f"import {spec.wrapper_module} as {spec.wrapper_module}",
        )

    module_name = f"cpp_python_communication_{spec.identifier}"
    module = types.ModuleType(module_name)
    module.__file__ = str(module_path)
    module.__package__ = ""
    sys.modules[module_name] = module
    exec(compile(source, str(module_path), "exec"), module.__dict__)
    return module


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("domain", nargs="?", type=int, default=DEFAULT_DOMAIN)
    parser.add_argument("--summary-period", type=float, default=1.0)
    parser.add_argument("--keep-going", action="store_true")
    args = parser.parse_args()

    _prepend_sys_path(PLUGIN_PYTHON_DIR)
    _prepend_sys_path(MESSAGE_DIR)

    reader_participant = SharedReaderParticipant(args.domain)
    readers: list[ReaderSlot] = []
    for spec in MESSAGE_SPECS:
        try:
            readers.append(reader_participant.add_reader(spec))
        except Exception as error:
            if not args.keep_going:
                reader_participant.close()
                raise
            print(f"[reader setup failed] rt/{spec.topic}: {error}", file=sys.stderr)

    print(f"Created {len(readers)} DDS readers on domain {args.domain}.")
    last_counts = {slot.topic: 0 for slot in readers}

    try:
        while True:
            time.sleep(args.summary_period)
            changed = []
            for slot in readers:
                count = slot.listener.sample_count
                previous = last_counts[slot.topic]
                if count != previous:
                    changed.append(f"{slot.topic}: +{count - previous} ({count})")
                    last_counts[slot.topic] = count

            if changed:
                print("\n".join(changed))
            else:
                print("No samples received in this interval.")
            # if all the last_counts are greater than 0, we can stopping
            if all(count > 0 for count in last_counts.values()):
                print("All readers have received at least one sample. Stopping.")
                break
    finally:
        reader_participant.close()


if __name__ == "__main__":
    raise SystemExit(main())
